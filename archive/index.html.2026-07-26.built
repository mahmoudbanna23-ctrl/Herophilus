<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="apple-touch-icon" href="data:image/png;base64,">
<link rel="icon" href="data:image/png;base64,">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Herophilus">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="mobile-web-app-capable" content="yes">
<meta name="theme-color" content="#231a4d">
<meta name="description" content="Herophilus — clinical question bank and revision schedule">
<title>Herophilus — 2nd Term Question Bank</title>
<style>
:root{
  --ink:#181334;
  --ink-2:#3b3563;
  --ink-3:#6a6390;
  --ink-4:#9b95bb;
  --bg:#f2f4fd;
  --bg-2:#e8ebfa;
  --card:#ffffff;
  --line:#ded9f2;
  --line-2:#c6bfe8;
  --rail:#231a4d;
  --rail-2:#332a63;
  --rail-3:#463b7d;
  --rail-text:#b7b0dc;

  --ent:#ff5a5f;
  --ophtho:#00b37e;
  --neuro:#8b5cf6;
  --peds:#3b82f6;
  --revision:#6a6390;
  --buffer:#f59e0b;

  --ok:#00a86b;
  --ok-bg:#e0faf0;
  --bad:#ff4757;
  --bad-bg:#ffecee;
  --gold:#ffc94a;
  --gold-bg:#fff6e0;

  --r:16px;
  --r-sm:11px;
  --pop:3px 3px 0;
  --pop-lg:5px 5px 0;
}
*{box-sizing:border-box}
html,body{margin:0;padding:0}
body{
  font-family:"Nunito","Quicksand",-apple-system,"Segoe UI",system-ui,sans-serif;
  background:var(--bg);color:var(--ink);font-size:15px;line-height:1.5;
  -webkit-font-smoothing:antialiased;
  background-image:radial-gradient(circle at 12% 8%, rgba(139,92,246,.05) 0, transparent 42%),
                   radial-gradient(circle at 88% 4%, rgba(59,130,246,.05) 0, transparent 38%);
  background-attachment:fixed;
}
button{font-family:inherit;font-size:inherit;cursor:pointer;border:none;background:none;color:inherit}
input{font-family:inherit;font-size:inherit}
:focus-visible{outline:3px solid var(--neuro);outline-offset:2px;border-radius:6px}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}

/* ---------- Layout ---------- */
.app{display:flex;min-height:100vh}
.rail{
  width:238px;flex-shrink:0;background:var(--rail);color:var(--rail-text);
  display:flex;flex-direction:column;position:sticky;top:0;height:100vh;overflow-y:auto;
  border-right:3px solid #150f33;
}
.rail-head{padding:20px 16px 12px}
.logo{display:flex;align-items:center;gap:9px;color:#fff;font-weight:900;letter-spacing:-.03em;font-size:19px}
.logo .blip{
  width:26px;height:26px;border-radius:9px;background:linear-gradient(135deg,var(--ent),var(--gold));
  display:flex;align-items:center;justify-content:center;font-size:14px;
  box-shadow:2px 2px 0 rgba(0,0,0,.28);flex-shrink:0;transform:rotate(-6deg);
}
.rail-sub{font-size:10.5px;color:#7d75ab;margin-top:4px;letter-spacing:.09em;text-transform:uppercase;font-weight:700}

.streak{
  margin:8px 12px 4px;padding:10px 12px;border-radius:12px;
  background:linear-gradient(135deg,rgba(255,201,74,.16),rgba(255,90,95,.13));
  border:1.5px solid rgba(255,201,74,.3);display:flex;align-items:center;gap:9px;
}
.streak .fl{font-size:17px}
.streak .n{color:#ffd977;font-weight:900;font-size:16px;line-height:1}
.streak .t{font-size:10.5px;color:#a89fd4;line-height:1.25;font-weight:600}

.nav{padding:6px 10px 20px;flex:1}
.nav-label{font-size:9.5px;letter-spacing:.13em;text-transform:uppercase;color:#6a619a;padding:15px 8px 6px;font-weight:800}
.nav-item{
  display:flex;align-items:center;gap:10px;width:100%;text-align:left;
  padding:9px 11px;border-radius:11px;color:var(--rail-text);font-size:13.5px;font-weight:600;
  transition:transform .13s cubic-bezier(.34,1.56,.64,1),background .13s,color .13s;
}
.nav-item:hover{background:var(--rail-2);color:#fff;transform:translateX(3px)}
.nav-item.on{background:var(--rail-3);color:#fff;font-weight:800;box-shadow:inset 3px 0 0 var(--gold)}
.nav-item .ic{width:19px;text-align:center;flex-shrink:0;font-size:15px}
.nav-item .cnt{margin-left:auto;font-size:11px;color:#7d75ab;font-variant-numeric:tabular-nums;font-weight:700}
.nav-item.on .cnt{color:#c2bbe4}
.badge-due{
  margin-left:auto;background:var(--ent);color:#fff;font-size:10.5px;font-weight:900;
  padding:2px 7px;border-radius:20px;min-width:20px;text-align:center;
  box-shadow:0 0 0 3px rgba(255,90,95,.2);
}

.main{flex:1;min-width:0;display:flex;flex-direction:column}
.topbar{
  display:flex;align-items:center;gap:14px;padding:13px 26px;
  border-bottom:2px solid var(--line);background:rgba(242,244,253,.93);
  position:sticky;top:0;z-index:20;backdrop-filter:blur(10px);
}
.search-wrap{position:relative;flex:1;max-width:440px}
.search{
  width:100%;padding:9px 13px 9px 35px;border:2px solid var(--line-2);border-radius:12px;
  background:var(--card);font-size:13.5px;color:var(--ink);font-weight:600;transition:box-shadow .14s,border-color .14s;
}
.search:focus{border-color:var(--neuro);box-shadow:var(--pop) rgba(139,92,246,.3);outline:none}
.search::placeholder{color:var(--ink-4);font-weight:500}
.search-ic{position:absolute;left:12px;top:50%;transform:translateY(-50%);font-size:14px;pointer-events:none}
.results{
  position:absolute;top:calc(100% + 7px);left:0;right:0;background:var(--card);
  border:2px solid var(--ink);border-radius:14px;box-shadow:var(--pop-lg) rgba(24,19,52,.18);
  max-height:380px;overflow-y:auto;z-index:40;display:none;
}
.results.show{display:block}
.res-item{padding:11px 14px;border-bottom:1.5px solid var(--line);cursor:pointer;font-size:13px}
.res-item:last-child{border-bottom:none}
.res-item:hover{background:var(--bg-2)}
.res-tag{font-size:9.5px;text-transform:uppercase;letter-spacing:.08em;font-weight:900;margin-bottom:3px}
.res-txt{color:var(--ink-2);line-height:1.45}
.res-empty{padding:16px 14px;color:var(--ink-4);font-size:13px}

.topbar-actions{margin-left:auto;display:flex;gap:7px;align-items:center}
.tb-btn{padding:7px 12px;border-radius:10px;font-size:12.5px;color:var(--ink-3);font-weight:700;transition:background .13s,transform .13s}
.tb-btn:hover{background:var(--bg-2);color:var(--ink);transform:translateY(-1px)}

.page{padding:28px;max-width:1180px;width:100%;margin:0 auto;flex:1}

/* ---------- Type ---------- */
h1{font-size:31px;font-weight:900;letter-spacing:-.035em;margin:0 0 5px;line-height:1.1}
h2{font-size:18px;font-weight:800;letter-spacing:-.02em;margin:0 0 13px}
.page-sub{color:var(--ink-3);font-size:14px;margin:0 0 26px;font-weight:500;max-width:640px;line-height:1.55}
.eyebrow{
  display:inline-block;font-size:10px;letter-spacing:.13em;text-transform:uppercase;font-weight:900;
  padding:4px 11px;border-radius:20px;background:var(--ink);color:#fff;margin-bottom:11px;
  transform:rotate(-1.2deg);
}

/* ---------- Cards ---------- */
.grid{display:grid;gap:15px}
.g3{grid-template-columns:repeat(auto-fill,minmax(258px,1fr))}
.g4{grid-template-columns:repeat(auto-fit,minmax(158px,1fr))}
.card{
  background:var(--card);border:2.5px solid var(--ink);border-radius:var(--r);
  padding:17px;text-align:left;width:100%;box-shadow:var(--pop) rgba(24,19,52,.16);
  transition:transform .15s cubic-bezier(.34,1.56,.64,1),box-shadow .15s;
}
button.card:hover:not(:disabled){transform:translate(-2px,-2px);box-shadow:var(--pop-lg) var(--c,rgba(24,19,52,.3))}
button.card:active:not(:disabled){transform:translate(1px,1px);box-shadow:1px 1px 0 rgba(24,19,52,.2)}

.mod-card{position:relative;overflow:hidden}
.mod-card::after{
  content:"";position:absolute;right:-24px;top:-24px;width:74px;height:74px;border-radius:50%;
  background:var(--c);opacity:.11;
}
.mod-top{display:flex;align-items:center;gap:10px;margin-bottom:6px}
.mod-ic{
  width:36px;height:36px;border-radius:11px;background:var(--c);display:flex;align-items:center;
  justify-content:center;font-size:18px;flex-shrink:0;box-shadow:2px 2px 0 rgba(24,19,52,.2);
}
.mod-name{font-weight:900;font-size:16.5px;letter-spacing:-.02em}
.mod-meta{font-size:12px;color:var(--ink-3);margin-bottom:13px;font-weight:600}

.ringrow{display:flex;align-items:center;gap:13px}
.ring{width:52px;height:52px;flex-shrink:0;position:relative}
.ring svg{transform:rotate(-90deg)}
.ring .rv{
  position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
  font-size:12.5px;font-weight:900;font-variant-numeric:tabular-nums;
}
.ringmeta{flex:1;min-width:0}
.ringmeta .a{font-size:19px;font-weight:900;font-variant-numeric:tabular-nums;line-height:1.1}
.ringmeta .b{font-size:11.5px;color:var(--ink-3);font-weight:600}

.stat{
  background:var(--card);border:2.5px solid var(--ink);border-radius:var(--r);padding:15px;
  box-shadow:var(--pop) rgba(24,19,52,.16);position:relative;overflow:hidden;
}
.stat .n{font-size:31px;font-weight:900;letter-spacing:-.04em;font-variant-numeric:tabular-nums;line-height:1.05}
.stat .l{font-size:11.5px;color:var(--ink-3);margin-top:3px;font-weight:700}
.stat .emo{position:absolute;right:11px;top:10px;font-size:19px;opacity:.3}

/* ---------- Chapter rows ---------- */
.grouphdr{
  display:flex;align-items:center;gap:10px;margin:24px 0 11px;
  font-size:10.5px;letter-spacing:.11em;text-transform:uppercase;font-weight:900;color:var(--ink-3);
}
.grouphdr::after{content:"";flex:1;height:2.5px;background:var(--line);border-radius:3px}
.ch-row{
  display:flex;align-items:center;gap:13px;padding:12px 15px;background:var(--card);
  border:2.5px solid var(--ink);border-radius:13px;margin-bottom:9px;width:100%;text-align:left;
  box-shadow:2px 2px 0 rgba(24,19,52,.13);
  transition:transform .13s cubic-bezier(.34,1.56,.64,1),box-shadow .13s;
}
.ch-row:hover:not(:disabled){transform:translate(-2px,-2px);box-shadow:4px 4px 0 rgba(24,19,52,.2)}
.ch-row:disabled{opacity:.45;cursor:default;box-shadow:none;border-style:dashed}
.ch-dot{width:11px;height:11px;border-radius:50%;flex-shrink:0;border:2px solid var(--ink)}
.ch-name{flex:1;font-size:14px;font-weight:700}
.ch-count{font-size:11.5px;color:var(--ink-4);font-variant-numeric:tabular-nums;font-weight:700}
.ch-acc{font-size:12px;font-weight:900;font-variant-numeric:tabular-nums;min-width:40px;text-align:right}

/* ---------- Question ---------- */
.qwrap{max-width:830px;margin:0 auto}
.qhead{display:flex;align-items:center;gap:10px;margin-bottom:17px;flex-wrap:wrap}
.pill{
  font-size:10px;font-weight:900;letter-spacing:.06em;text-transform:uppercase;padding:4px 11px;
  border-radius:20px;color:#fff;border:2px solid var(--ink);box-shadow:2px 2px 0 rgba(24,19,52,.18);
}
.pill.ghost{background:var(--bg-2);color:var(--ink-3)}
.qprog{
  margin-left:auto;font-size:12px;color:var(--ink-2);font-variant-numeric:tabular-nums;font-weight:800;
  background:var(--card);padding:4px 11px;border-radius:20px;border:2px solid var(--ink);
}

.qcard{background:var(--card);border:3px solid var(--ink);border-radius:20px;padding:27px 29px;box-shadow:6px 6px 0 rgba(24,19,52,.15)}
.stem{
  font-family:"Iowan Old Style","Palatino Linotype",Palatino,Georgia,serif;
  font-size:16.5px;line-height:1.64;color:var(--ink);margin-bottom:21px;
}
.stem p{margin:0 0 12px}
.stem p:last-child{margin-bottom:0}
.stem table{border-collapse:separate;border-spacing:0;width:100%;margin:13px 0;font-size:13px;font-family:"Nunito",sans-serif;border:2px solid var(--ink);border-radius:10px;overflow:hidden}
.stem th,.stem td{border-bottom:1.5px solid var(--line);padding:7px 10px;text-align:left}
.stem th{background:var(--bg-2);font-weight:800}
.stem tr:last-child td{border-bottom:none}

.opts{display:flex;flex-direction:column;gap:9px}
.opt{
  display:flex;gap:13px;align-items:flex-start;padding:13px 16px;
  border:2.5px solid var(--line-2);border-radius:13px;background:var(--card);
  text-align:left;width:100%;line-height:1.5;font-weight:600;
  transition:transform .12s cubic-bezier(.34,1.56,.64,1),border-color .12s,box-shadow .12s;
}
.opt:hover:not(:disabled){border-color:var(--ink);transform:translateX(4px);box-shadow:-3px 3px 0 rgba(24,19,52,.12)}
.opt:disabled{cursor:default}
.opt .ltr{
  width:26px;height:26px;border-radius:9px;border:2.5px solid var(--line-2);
  display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:900;
  flex-shrink:0;color:var(--ink-3);margin-top:1px;transition:all .12s;
}
.opt.sel{border-color:var(--neuro);background:#f6f2ff;transform:translateX(4px);box-shadow:-3px 3px 0 rgba(139,92,246,.28)}
.opt.sel .ltr{background:var(--neuro);border-color:var(--neuro);color:#fff}
.opt.correct{border-color:var(--ok);background:var(--ok-bg);box-shadow:-3px 3px 0 rgba(0,168,107,.25)}
.opt.correct .ltr{background:var(--ok);border-color:var(--ok);color:#fff}
.opt.wrong{border-color:var(--bad);background:var(--bad-bg);box-shadow:-3px 3px 0 rgba(255,71,87,.25)}
.opt.wrong .ltr{background:var(--bad);border-color:var(--bad);color:#fff}
.opt .mark{margin-left:auto;font-weight:900;font-size:17px;flex-shrink:0}

.qactions{display:flex;gap:10px;margin-top:22px;align-items:center;flex-wrap:wrap}
.btn{
  padding:11px 20px;border-radius:12px;font-size:13.5px;font-weight:800;
  background:var(--ink);color:#fff;border:2.5px solid var(--ink);box-shadow:var(--pop) rgba(24,19,52,.3);
  transition:transform .13s cubic-bezier(.34,1.56,.64,1),box-shadow .13s;
}
.btn:hover:not(:disabled){transform:translate(-2px,-2px);box-shadow:var(--pop-lg) rgba(24,19,52,.35)}
.btn:active:not(:disabled){transform:translate(1px,1px);box-shadow:1px 1px 0 rgba(24,19,52,.3)}
.btn:disabled{opacity:.32;cursor:default;box-shadow:none}
.btn.sec{background:var(--card);color:var(--ink)}
.btn.go{background:var(--neuro);border-color:var(--ink)}
.btn.flag.on{background:var(--gold);color:var(--ink)}

@keyframes pop{0%{transform:scale(.86)}60%{transform:scale(1.04)}100%{transform:scale(1)}}
.verdict{
  margin-top:21px;padding:15px 18px;border-radius:14px;font-weight:900;font-size:15px;
  display:flex;align-items:center;gap:11px;border:2.5px solid var(--ink);animation:pop .32s cubic-bezier(.34,1.56,.64,1);
}
.verdict.ok{background:var(--ok-bg);color:#00734a;box-shadow:var(--pop) rgba(0,168,107,.3)}
.verdict.bad{background:var(--bad-bg);color:#c72736;box-shadow:var(--pop) rgba(255,71,87,.3)}
.verdict .big{font-size:22px}

.conf{margin-top:17px;padding:15px 17px;background:var(--gold-bg);border:2.5px solid var(--ink);border-radius:14px;box-shadow:var(--pop) rgba(255,201,74,.4)}
.conf-q{font-size:13px;color:var(--ink-2);margin-bottom:11px;font-weight:700}
.conf-btns{display:flex;gap:8px;flex-wrap:wrap}
.conf-b{
  padding:8px 15px;border:2.5px solid var(--ink);border-radius:20px;font-size:12.5px;
  background:var(--card);font-weight:800;transition:transform .12s cubic-bezier(.34,1.56,.64,1),box-shadow .12s;
}
.conf-b:hover{transform:translateY(-2px);box-shadow:0 3px 0 rgba(24,19,52,.25)}
.conf-b.on{background:var(--ink);color:#fff}

.explain{margin-top:18px;border:2.5px solid var(--ink);border-radius:14px;overflow:hidden;box-shadow:var(--pop) rgba(24,19,52,.14)}
.ex-head{
  display:flex;align-items:center;gap:10px;padding:13px 17px;background:var(--bg-2);
  width:100%;text-align:left;font-weight:900;font-size:13.5px;transition:background .13s;
}
.ex-head:hover{background:#dfe3f7}
.ex-head .chev{margin-left:auto;transition:transform .22s cubic-bezier(.34,1.56,.64,1)}
.ex-head.open .chev{transform:rotate(180deg)}
.ex-body{padding:19px 21px;font-size:14.3px;line-height:1.68;color:var(--ink-2);display:none}
.ex-body.open{display:block;animation:pop .24s ease}
.ex-body p{margin:0 0 13px}
.ex-body p:last-child{margin-bottom:0}
.ex-body strong{color:var(--ink);font-weight:800}
.ex-body em{color:var(--ink-3)}
.objective{
  margin-top:17px;padding:14px 17px;background:linear-gradient(135deg,#eef2ff,#f6f2ff);
  border:2.5px solid var(--neuro);border-radius:12px;font-size:13.8px;line-height:1.6;
}
.objective b{display:block;font-size:10px;letter-spacing:.11em;text-transform:uppercase;color:var(--neuro);margin-bottom:5px;font-weight:900}
.noexp{padding:17px 21px;color:var(--ink-4);font-size:13.5px;font-style:italic}

/* ---------- Schedule ---------- */
.sched-legend{display:flex;gap:15px;flex-wrap:wrap;margin-bottom:20px;font-size:12.5px;color:var(--ink-3);font-weight:700}
.leg{display:flex;align-items:center;gap:7px}
.leg .sw{width:13px;height:13px;border-radius:4px;border:2px solid var(--ink)}
.day{
  display:flex;gap:14px;align-items:center;padding:13px 15px;background:var(--card);
  border:2.5px solid var(--ink);border-radius:14px;margin-bottom:9px;
  box-shadow:2px 2px 0 rgba(24,19,52,.13);transition:transform .13s,box-shadow .13s;
}
.day:hover{transform:translate(-1px,-1px);box-shadow:4px 4px 0 rgba(24,19,52,.18)}
.day.rest{background:var(--bg-2);opacity:.72;border-style:dashed}
.day.missed{background:var(--bad-bg);border-color:var(--bad)}
.day.done{background:var(--ok-bg);border-color:var(--ok)}
.day.today{border-color:var(--neuro);box-shadow:4px 4px 0 rgba(139,92,246,.35)}
.day-date{width:74px;flex-shrink:0}
.day-d{font-weight:900;font-size:14px;font-variant-numeric:tabular-nums;letter-spacing:-.02em}
.day-w{font-size:10.5px;color:var(--ink-4);font-weight:700;text-transform:uppercase;letter-spacing:.05em}
.day-body{flex:1;min-width:0}
.day-line{font-size:13.2px;margin-bottom:4px;line-height:1.45;font-weight:600}
.day-line:last-child{margin-bottom:0}
.day-line.faded{opacity:.45;text-decoration:line-through}
.tag{
  display:inline-block;font-size:9.5px;font-weight:900;letter-spacing:.07em;text-transform:uppercase;
  padding:3px 10px;border-radius:7px;color:#fff;margin-right:10px;vertical-align:1.5px;
  border:1.5px solid var(--ink);white-space:nowrap;box-shadow:1.5px 1.5px 0 rgba(24,19,52,.22);
}
.movednote{font-size:11px;color:var(--neuro);font-weight:800;margin-top:4px}
.day-marks{display:flex;gap:7px;flex-shrink:0}
.mk{
  width:38px;height:38px;border-radius:11px;border:2.5px solid var(--ink);background:var(--card);
  display:flex;align-items:center;justify-content:center;font-size:15px;
  transition:transform .13s cubic-bezier(.34,1.56,.64,1),box-shadow .13s,background .13s;
  box-shadow:2px 2px 0 rgba(24,19,52,.16);
}
.mk:hover{transform:translate(-1px,-1px);box-shadow:3px 3px 0 rgba(24,19,52,.25)}
.mk:active{transform:translate(1px,1px);box-shadow:1px 1px 0 rgba(24,19,52,.2)}
.mk.done.on{background:var(--ok);color:#fff}
.mk.miss.on{background:var(--bad);color:#fff}
.mk .lbl{position:absolute;opacity:0;pointer-events:none}


.track{
  display:flex;align-items:center;gap:11px;padding:9px 0;
  border-bottom:1.5px dashed var(--line);
}
.track:last-child{border-bottom:none}
.track-body{flex:1;min-width:0;font-size:13.4px;font-weight:600;line-height:1.55}
.track.is-done .track-body{opacity:.6}
.track.is-missed .track-body{opacity:.55;text-decoration:line-through}
.track.catchup{background:rgba(139,92,246,.07);border-radius:9px;padding:8px 11px;margin-top:5px;border:1.5px dashed var(--neuro)}
.day{align-items:stretch}
.day-body{display:flex;flex-direction:column;justify-content:center}


/* ---------- Highlighter ---------- */
mark.hl{background:transparent;padding:1.5px 1px;border-radius:4px;color:inherit;
  box-decoration-break:clone;-webkit-box-decoration-break:clone}
mark.hl[data-c="y"]{background:#ffe97a}
mark.hl[data-c="g"]{background:#a8f0bd}
mark.hl[data-c="p"]{background:#ffc2dc}
mark.hl[data-c="b"]{background:#a9d6ff}

.mkbar{
  display:flex;align-items:center;gap:7px;flex-wrap:wrap;margin-bottom:15px;
  padding:9px 12px;background:var(--bg-2);border:2px dashed var(--line-2);border-radius:12px;
}
.mkbar .lb{font-size:10.5px;font-weight:900;letter-spacing:.09em;text-transform:uppercase;color:var(--ink-3);margin-right:2px}
.pen{
  width:29px;height:29px;border-radius:9px;border:2.5px solid var(--ink);
  box-shadow:2px 2px 0 rgba(24,19,52,.18);transition:transform .13s cubic-bezier(.34,1.56,.64,1),box-shadow .13s;
  position:relative;
}
.pen:hover{transform:translate(-1px,-1px);box-shadow:3px 3px 0 rgba(24,19,52,.26)}
.pen.on{transform:translateY(-3px);box-shadow:2px 5px 0 rgba(24,19,52,.3)}
.pen.on::after{content:"";position:absolute;inset:-6px;border:2.5px solid var(--ink);border-radius:13px}
.pen.y{background:#ffe97a}.pen.g{background:#a8f0bd}.pen.p{background:#ffc2dc}.pen.b{background:#a9d6ff}
.pen.er{background:var(--card);font-size:14px;display:flex;align-items:center;justify-content:center}
.mkbar .hint{font-size:11.5px;color:var(--ink-4);font-weight:600;margin-left:auto}
.mkbar .clr{
  font-size:11.5px;font-weight:800;color:var(--ink-3);padding:5px 11px;border-radius:20px;
  border:2px solid var(--line-2);background:var(--card);
}
.mkbar .clr:hover{border-color:var(--ink);color:var(--ink)}
.stem{-webkit-user-select:text;user-select:text}
.stem.arm{cursor:crosshair}


/* ---------- Jump navigator ---------- */
.modal.wide{max-width:660px}
.jumprow{display:flex;gap:9px;margin-bottom:16px;flex-wrap:wrap;align-items:center}
.jumpin{
  width:112px;padding:9px 13px;border:2.5px solid var(--ink);border-radius:11px;
  font-size:14px;font-weight:800;background:var(--card);color:var(--ink);
  box-shadow:2px 2px 0 rgba(24,19,52,.15);
}
.jumpin::-webkit-outer-spin-button,.jumpin::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}
.jumpin{-moz-appearance:textfield}
.jumpkey{display:flex;gap:13px;flex-wrap:wrap;font-size:11.5px;color:var(--ink-3);font-weight:700;margin-bottom:13px}
.jumpkey .k{display:flex;align-items:center;gap:6px}
.jumpkey .sw{width:13px;height:13px;border-radius:4px;border:2px solid var(--ink)}
.qgrid{
  display:grid;grid-template-columns:repeat(auto-fill,minmax(46px,1fr));gap:8px;
  max-height:42vh;overflow-y:auto;padding:5px 3px;
}
.qg{
  aspect-ratio:1;border-radius:10px;border:2.5px solid var(--ink);font-weight:900;font-size:12.5px;
  background:var(--card);display:flex;align-items:center;justify-content:center;position:relative;
  box-shadow:2px 2px 0 rgba(24,19,52,.15);
  transition:transform .12s cubic-bezier(.34,1.56,.64,1),box-shadow .12s;
}
.qg:hover{transform:translate(-2px,-2px);box-shadow:4px 4px 0 rgba(24,19,52,.24)}
.qg.ok{background:var(--ok-bg);color:#00734a;border-color:var(--ok)}
.qg.bad{background:var(--bad-bg);color:#c72736;border-color:var(--bad)}
.qg.cur{background:var(--neuro);color:#fff;transform:translate(-2px,-2px);box-shadow:4px 4px 0 rgba(24,19,52,.3)}
.qg.flagged::after{
  content:"";position:absolute;top:-5px;right:-5px;width:11px;height:11px;
  background:var(--gold);border:2px solid var(--ink);border-radius:50%;
}
.qprog{border:2px solid var(--ink);cursor:pointer;transition:transform .12s,box-shadow .12s}
.qprog:hover{transform:translate(-1px,-1px);box-shadow:2px 2px 0 rgba(24,19,52,.22)}



/* ---------- Schedule editor ---------- */
.edbar{display:flex;gap:9px;flex-wrap:wrap;align-items:center;margin-bottom:18px}
.day.editing{border-style:dashed;border-color:var(--neuro);background:#faf8ff}
.ed-item{display:flex;gap:8px;align-items:center;padding:7px 0;flex-wrap:wrap}
.ed-lab,.ed-txt{
  padding:7px 11px;border:2px solid var(--line-2);border-radius:9px;font-size:12.8px;
  background:var(--card);color:var(--ink);font-weight:600;font-family:inherit;
}
.ed-lab{width:132px;flex-shrink:0}
.ed-txt{flex:1;min-width:150px}
.ed-lab:focus,.ed-txt:focus{border-color:var(--neuro);outline:none}
.ed-col{width:30px;height:30px;border-radius:8px;border:2.5px solid var(--ink);flex-shrink:0;cursor:pointer}
.ed-x{
  width:29px;height:29px;border-radius:8px;border:2px solid var(--bad);color:var(--bad);
  background:var(--card);font-weight:900;flex-shrink:0;font-size:13px;
}
.ed-x:hover{background:var(--bad-bg)}
.ed-add{
  font-size:11.5px;font-weight:800;color:var(--neuro);padding:6px 12px;border-radius:20px;
  border:2px dashed var(--neuro);background:transparent;margin-top:5px;
}
.ed-add:hover{background:#f4efff}
.ed-day-tools{display:flex;gap:7px;flex-shrink:0;flex-wrap:wrap}
.ed-t{
  font-size:11px;font-weight:800;padding:5px 10px;border-radius:8px;border:2px solid var(--line-2);
  background:var(--card);color:var(--ink-3);
}
.ed-t:hover{border-color:var(--ink);color:var(--ink)}
.ed-t.danger{border-color:var(--bad);color:var(--bad)}
.ed-t.on{background:var(--ink);color:#fff;border-color:var(--ink)}
.newday{display:flex;gap:9px;align-items:center;flex-wrap:wrap;padding:14px;margin-top:10px;
  border:2.5px dashed var(--line-2);border-radius:14px;background:var(--card)}
.newday input[type=date]{padding:8px 11px;border:2px solid var(--line-2);border-radius:9px;
  font-family:inherit;font-size:13px;font-weight:600;background:var(--card);color:var(--ink)}
.palette{display:flex;gap:6px;flex-wrap:wrap}
.pal{width:24px;height:24px;border-radius:7px;border:2.5px solid var(--ink);cursor:pointer}
.pal.on{transform:translateY(-3px);box-shadow:0 3px 0 rgba(24,19,52,.3)}


/* ---------- Profile gate ---------- */
.gate{
  position:fixed;inset:0;z-index:200;background:var(--bg);
  background-image:radial-gradient(circle at 15% 10%, rgba(139,92,246,.10) 0, transparent 45%),
                   radial-gradient(circle at 85% 8%, rgba(255,90,95,.09) 0, transparent 42%);
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  padding:30px 20px;overflow-y:auto;
}
.gate.hide{display:none}
.gate .glogo{display:flex;align-items:center;gap:11px;font-weight:900;font-size:24px;letter-spacing:-.03em;margin-bottom:6px}
.gate .glogo .blip{
  width:36px;height:36px;border-radius:12px;background:linear-gradient(135deg,var(--ent),var(--gold));
  display:flex;align-items:center;justify-content:center;font-size:19px;
  box-shadow:3px 3px 0 rgba(24,19,52,.25);transform:rotate(-6deg);
}
.gate h2{font-size:19px;color:var(--ink-3);font-weight:700;margin:0 0 30px}
.pgrid{display:flex;gap:20px;flex-wrap:wrap;justify-content:center;max-width:760px}
.pcard{
  width:132px;display:flex;flex-direction:column;align-items:center;gap:10px;
  background:transparent;transition:transform .16s cubic-bezier(.34,1.56,.64,1);
}
.pcard:hover{transform:translateY(-5px)}
.pav{
  width:96px;height:96px;border-radius:24px;border:3px solid var(--ink);
  display:flex;align-items:center;justify-content:center;font-size:44px;overflow:hidden;
  box-shadow:5px 5px 0 rgba(24,19,52,.2);position:relative;
}
.pcard:hover .pav{box-shadow:7px 7px 0 rgba(24,19,52,.28)}
.pav img{width:100%;height:100%;object-fit:cover;display:block}
.pav .lock{
  position:absolute;right:-6px;bottom:-6px;width:28px;height:28px;border-radius:50%;
  background:var(--gold);border:2.5px solid var(--ink);display:flex;align-items:center;
  justify-content:center;font-size:12px;
}
.pname{font-weight:800;font-size:14.5px;text-align:center;line-height:1.3;word-break:break-word}
.pcard.add .pav{border-style:dashed;background:var(--card);font-size:38px;color:var(--ink-4);box-shadow:none}
.pcard.add:hover .pav{border-color:var(--neuro);color:var(--neuro)}
.gate .gfoot{margin-top:34px;display:flex;gap:10px;flex-wrap:wrap;justify-content:center}

.emgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(46px,1fr));gap:8px;margin-bottom:16px;max-height:180px;overflow-y:auto}
.emb{
  aspect-ratio:1;border-radius:11px;border:2.5px solid var(--line-2);background:var(--card);
  font-size:22px;display:flex;align-items:center;justify-content:center;
  transition:transform .12s cubic-bezier(.34,1.56,.64,1);
}
.emb:hover{transform:translateY(-2px);border-color:var(--ink)}
.emb.on{border-color:var(--ink);background:var(--ink);transform:translateY(-2px)}
.colrow{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px}
.colb{width:34px;height:34px;border-radius:10px;border:2.5px solid var(--ink);
  transition:transform .12s cubic-bezier(.34,1.56,.64,1)}
.colb:hover{transform:translateY(-2px)}
.colb.on{transform:translateY(-4px);box-shadow:0 4px 0 rgba(24,19,52,.3)}
.avprev{
  width:88px;height:88px;border-radius:22px;border:3px solid var(--ink);margin:0 auto 16px;
  display:flex;align-items:center;justify-content:center;font-size:40px;overflow:hidden;
  box-shadow:4px 4px 0 rgba(24,19,52,.2);
}
.avprev img{width:100%;height:100%;object-fit:cover}
.pinbox{
  display:flex;gap:9px;justify-content:center;margin:14px 0;
}
.pind{
  width:52px;height:60px;border:2.5px solid var(--ink);border-radius:12px;text-align:center;
  font-size:24px;font-weight:900;background:var(--card);color:var(--ink);
  box-shadow:2px 2px 0 rgba(24,19,52,.18);
}
.pind:focus{border-color:var(--neuro);outline:none;box-shadow:3px 3px 0 rgba(139,92,246,.35)}
.pinerr{color:var(--bad);font-weight:800;font-size:13px;text-align:center;margin-top:4px;min-height:18px}

.railprof{
  display:flex;align-items:center;gap:10px;margin:4px 12px 8px;padding:9px 11px;border-radius:12px;
  background:var(--rail-2);width:calc(100% - 24px);text-align:left;
  transition:background .13s;
}
.railprof:hover{background:var(--rail-3)}
.railprof .rav{
  width:32px;height:32px;border-radius:10px;display:flex;align-items:center;justify-content:center;
  font-size:17px;flex-shrink:0;overflow:hidden;border:2px solid rgba(255,255,255,.22);
}
.railprof .rav img{width:100%;height:100%;object-fit:cover}
.railprof .rn{font-size:13px;font-weight:800;color:#fff;line-height:1.2;flex:1;min-width:0;
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.railprof .rs{font-size:10px;color:#7d75ab;font-weight:700}


/* ---------- Cloud sync ---------- */
.gsign{
  display:flex;align-items:center;gap:11px;padding:12px 20px;border-radius:14px;
  background:#fff;border:2.5px solid var(--ink);font-weight:800;font-size:14px;color:var(--ink);
  box-shadow:4px 4px 0 rgba(24,19,52,.2);transition:transform .14s cubic-bezier(.34,1.56,.64,1),box-shadow .14s;
}
.gsign:hover{transform:translate(-2px,-2px);box-shadow:6px 6px 0 rgba(24,19,52,.28)}
.gsign svg{width:19px;height:19px;flex-shrink:0}
.gate .gor{margin:22px 0 4px;font-size:12px;font-weight:800;color:var(--ink-4);letter-spacing:.08em;text-transform:uppercase}
.syncdot{
  display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:6px;flex-shrink:0;
  background:var(--ink-4);vertical-align:1px;
}
.syncdot.ok{background:#4ade80}
.syncdot.busy{background:var(--gold);animation:blink 1s infinite}
.syncdot.err{background:var(--ent)}
.railsync{
  margin:0 12px 6px;padding:7px 11px;border-radius:10px;background:rgba(255,255,255,.05);
  font-size:10.5px;font-weight:700;color:#9990c4;display:flex;align-items:center;
}
.cfgbox{
  width:100%;min-height:150px;padding:12px 14px;border:2.5px solid var(--ink);border-radius:12px;
  font-family:ui-monospace,Menlo,monospace;font-size:11.5px;background:var(--card);color:var(--ink);
  line-height:1.55;resize:vertical;
}
.steps{counter-reset:s;font-size:13.3px;line-height:1.65;color:var(--ink-2);font-weight:500}
.steps li{margin-bottom:9px}
.steps code{background:var(--bg-2);padding:2px 7px;border-radius:5px;font-size:12px;font-weight:700}


.splash{
  position:fixed;inset:0;z-index:210;background:var(--bg);
  display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18px;
}
.splash.hide{display:none}
.splash .glogo{font-size:24px}
.splash .msg{font-size:13.5px;color:var(--ink-3);font-weight:700}
@keyframes spin{to{transform:rotate(360deg)}}
.spinner{
  width:34px;height:34px;border:3.5px solid var(--line-2);border-top-color:var(--neuro);
  border-radius:50%;animation:spin .8s linear infinite;
}


/* ---------- Theory (document view) ---------- */
.th-intro{
  background:linear-gradient(135deg,#eef2ff,#f6f2ff);border:2.5px solid var(--neuro);
  border-radius:14px;padding:16px 20px;font-size:14px;line-height:1.68;margin-bottom:22px;
  box-shadow:var(--pop) rgba(139,92,246,.22);
}
.th-toc{
  background:var(--card);border:2.5px solid var(--ink);border-radius:14px;padding:15px 19px;
  margin-bottom:26px;box-shadow:var(--pop) rgba(24,19,52,.14);
}
.th-toc .tl{font-size:10.5px;font-weight:900;letter-spacing:.11em;text-transform:uppercase;
  color:var(--ink-3);margin-bottom:11px}
.th-toc ol{margin:0;padding-left:19px}
.th-toc li{margin-bottom:6px;font-size:13.4px;font-weight:700}
.th-toc a{color:var(--ink-2);text-decoration:none;border-bottom:2px solid transparent}
.th-toc a:hover{color:var(--neuro);border-bottom-color:var(--neuro)}
.th-toc .wb{font-size:8.5px;margin-left:7px;padding:2px 6px;border-radius:5px;font-weight:900;
  letter-spacing:.06em;text-transform:uppercase;vertical-align:1.5px}

/* a section is now a chapter of a document, always open */
.th-sec{
  margin-bottom:34px;padding-left:20px;border-left:5px solid var(--c,var(--neuro));
  scroll-margin-top:80px;
}
.th-h{display:flex;align-items:center;gap:11px;margin-bottom:13px;flex-wrap:wrap}
.th-h h2{
  margin:0;font-size:21px;font-weight:900;letter-spacing:-.028em;color:var(--ink);line-height:1.2;
}
.th-num{
  font-size:11px;font-weight:900;color:var(--c,var(--neuro));letter-spacing:.1em;
  text-transform:uppercase;
}
.wbadge{
  font-size:8.5px;font-weight:900;letter-spacing:.09em;text-transform:uppercase;padding:3px 8px;
  border-radius:6px;border:1.5px solid var(--ink);flex-shrink:0;
}
.wbadge.must{background:var(--ent);color:#fff}
.wbadge.high{background:var(--gold);color:var(--ink)}
.wbadge.know{background:var(--bg-2);color:var(--ink-3)}
.th-body{font-size:14.6px;line-height:1.78;color:var(--ink-2)}
.th-body p{margin:0 0 14px}
.th-body strong{color:var(--ink);font-weight:800}
.th-body em{color:var(--ink-3)}
.th-body ul{margin:0 0 14px;padding-left:22px}
.th-body li{margin-bottom:7px}
.th-body li::marker{color:var(--c,var(--neuro))}
.th-body blockquote{
  margin:0 0 15px;padding:13px 18px;background:var(--gold-bg);border-left:4px solid var(--gold);
  border-radius:0 10px 10px 0;font-weight:700;color:var(--ink);font-size:14.5px;
}
.th-table{width:100%;border-collapse:separate;border-spacing:0;margin:4px 0 18px;font-size:13.3px;
  border:2.5px solid var(--ink);border-radius:12px;overflow:hidden}
.th-table th{background:var(--ink);color:#fff;text-align:left;padding:10px 13px;font-weight:800;
  font-size:11px;text-transform:uppercase;letter-spacing:.06em}
.th-table td{padding:10px 13px;border-bottom:1.5px solid var(--line);vertical-align:top;line-height:1.55}
.th-table tr:last-child td{border-bottom:none}
.th-table tr:nth-child(even) td{background:#fafaff}

.flow{margin:4px 0 18px;border:2.5px dashed var(--neuro);border-radius:14px;padding:16px 17px;background:#fbfaff}
.flow-title{font-size:11px;font-weight:900;letter-spacing:.09em;text-transform:uppercase;color:var(--neuro);margin-bottom:14px}
.fstep{margin-bottom:9px}
.fbox{background:var(--card);border:2.5px solid var(--ink);border-radius:11px;padding:11px 14px;
  box-shadow:2px 2px 0 rgba(24,19,52,.15)}
.fbox .ft{font-weight:800;font-size:13.6px;line-height:1.42}
.fbox .fn{font-size:12.4px;color:var(--ink-3);margin-top:5px;line-height:1.5;font-weight:600}
.fbox.alert{background:#fff4f4;border-color:var(--ent);box-shadow:2px 2px 0 rgba(255,90,95,.3)}
.fbox.alert .ft{color:#c72736}
.fbox.dec{background:var(--gold-bg);border-color:var(--gold)}
.farrow{text-align:center;color:var(--neuro);font-size:17px;line-height:1;margin:2px 0 7px;font-weight:900}
.fbranch{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:9px}
.fb{border:2px solid var(--line-2);border-radius:10px;padding:9px 12px;font-size:12.6px;font-weight:700;line-height:1.45}
.fb.y{background:#eefaf3;border-color:var(--ok)}
.fb.n{background:#fff0f0;border-color:var(--bad)}
.fb b{display:block;font-size:9.5px;letter-spacing:.09em;text-transform:uppercase;margin-bottom:4px}
.fb.y b{color:var(--ok)}
.fb.n b{color:var(--bad)}
@media(max-width:600px){.fbranch{grid-template-columns:1fr}}

.th-test{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-top:4px}
.th-test .lbl{font-size:12px;font-weight:800;color:var(--ink-3)}
.readtheory{
  display:flex;align-items:center;gap:9px;width:100%;text-align:left;margin-top:16px;
  padding:12px 16px;background:linear-gradient(135deg,#eef2ff,#f6f2ff);
  border:2.5px solid var(--neuro);border-radius:13px;font-weight:800;font-size:13.5px;
  box-shadow:var(--pop) rgba(139,92,246,.25);
  transition:transform .13s cubic-bezier(.34,1.56,.64,1),box-shadow .13s;
}
.readtheory:hover{transform:translate(-2px,-2px);box-shadow:var(--pop-lg) rgba(139,92,246,.3)}
.th-ch{display:flex;align-items:center;gap:13px;padding:14px 16px;background:var(--card);
  border:2.5px solid var(--ink);border-radius:13px;margin-bottom:9px;width:100%;text-align:left;
  box-shadow:2px 2px 0 rgba(24,19,52,.13);transition:transform .13s cubic-bezier(.34,1.56,.64,1),box-shadow .13s}
.th-ch:hover:not(:disabled){transform:translate(-2px,-2px);box-shadow:4px 4px 0 rgba(24,19,52,.2)}
.th-ch:disabled{opacity:.4;cursor:default;box-shadow:none;border-style:dashed}
.th-ch .n{flex:1;font-weight:700;font-size:14px}
.th-ch .m{font-size:11.5px;color:var(--ink-4);font-weight:700}
.doc-head{border-bottom:3px solid var(--ink);padding-bottom:14px;margin-bottom:22px}
.doc-meta{font-size:12.5px;color:var(--ink-3);font-weight:700;margin-top:6px}

/* ---------- Print / Save as PDF ---------- */
@media print{
  @page{margin:16mm 14mm}
  .rail,.topbar,.th-test,.th-toc .wb,.readtheory,.toast,.modal-bg,.splash,.gate{display:none!important}
  body{background:#fff!important;background-image:none!important;font-size:11pt}
  .app{display:block}
  .page{padding:0;max-width:100%}
  .th-sec{break-inside:auto;page-break-inside:auto;margin-bottom:20px;padding-left:12px}
  .th-h{break-after:avoid;page-break-after:avoid}
  .th-table,.flow,.fbox,.th-body blockquote{break-inside:avoid;page-break-inside:avoid}
  .th-intro,.th-toc{box-shadow:none}
  .fbox,.th-table,.th-toc,.th-intro{box-shadow:none!important}
  h1{font-size:22pt}
  .th-h h2{font-size:14pt}
  .th-body{font-size:10.5pt;line-height:1.55}
  a{text-decoration:none;color:inherit}
}
/* ---------- Misc ---------- */
.empty{text-align:center;padding:64px 20px;color:var(--ink-4)}
.empty .big{font-size:52px;margin-bottom:14px}
.empty h3{color:var(--ink-2);font-size:17px;margin:0 0 7px;font-weight:900}
.empty p{margin:0 auto;font-size:13.5px;max-width:400px;line-height:1.6;font-weight:500}

.toast{
  position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(90px);
  background:var(--ink);color:#fff;padding:13px 22px;border-radius:14px;font-size:13.5px;
  border:2.5px solid #000;box-shadow:4px 4px 0 rgba(0,0,0,.3);z-index:400;opacity:0;
  transition:all .3s cubic-bezier(.34,1.56,.64,1);font-weight:800;
}
.toast.show{transform:translateX(-50%) translateY(0);opacity:1}

.modal-bg{
  position:fixed;inset:0;background:rgba(24,19,52,.5);z-index:300;
  display:none;align-items:center;justify-content:center;padding:20px;backdrop-filter:blur(3px);
}
.modal-bg.show{display:flex}
.modal{
  background:var(--card);border:3px solid var(--ink);border-radius:20px;padding:27px;
  max-width:460px;width:100%;box-shadow:8px 8px 0 rgba(24,19,52,.3);animation:pop .3s cubic-bezier(.34,1.56,.64,1);
}
.modal h3{margin:0 0 9px;font-size:20px;font-weight:900;letter-spacing:-.02em}
.modal p{margin:0 0 19px;color:var(--ink-2);font-size:14px;line-height:1.6;font-weight:500}
.modal-actions{display:flex;gap:10px;justify-content:flex-end;flex-wrap:wrap}

.kbd{
  display:inline-block;padding:2px 8px;border:2px solid var(--ink);border-bottom-width:3px;
  border-radius:6px;font-size:11px;font-family:ui-monospace,Menlo,monospace;background:var(--bg-2);font-weight:800;
}
.shortcuts{display:grid;grid-template-columns:auto 1fr;gap:10px 17px;font-size:13px;align-items:center}
.shortcuts .d{color:var(--ink-3);font-weight:600}

.filterbar{display:flex;gap:9px;margin-bottom:20px;flex-wrap:wrap;align-items:center}
.chip{
  padding:8px 15px;border:2.5px solid var(--ink);border-radius:22px;font-size:12.5px;
  background:var(--card);font-weight:800;box-shadow:2px 2px 0 rgba(24,19,52,.15);
  transition:transform .13s cubic-bezier(.34,1.56,.64,1),box-shadow .13s;
}
.chip:hover{transform:translate(-1px,-1px);box-shadow:3px 3px 0 rgba(24,19,52,.25)}
.chip.on{background:var(--c,var(--ink));color:#fff}

@keyframes fall{to{transform:translateY(105vh) rotate(720deg);opacity:0}}
.confetti{position:fixed;top:-14px;width:11px;height:11px;z-index:250;pointer-events:none;animation:fall linear forwards}

.mobile-only{display:none}
@media(max-width:860px){
  .rail{position:fixed;left:-238px;z-index:60;transition:left .24s;box-shadow:8px 0 30px rgba(0,0,0,.3)}
  .rail.open{left:0}
  .mobile-only{display:block}
  .page{padding:18px 14px}
  .qcard{padding:20px 17px}
  .topbar{padding:10px 14px}
  h1{font-size:25px}
  .day{flex-wrap:wrap}
  .day-marks{margin-left:auto}
}
</style>
</head>
<body>
<div class="app">
  <aside class="rail" id="rail">
    <div class="rail-head">
      <div class="logo"><span class="blip">🩺</span> Herophilus</div>
      <div class="rail-sub">2nd Term · Q-Bank</div>
    </div>
    <button class="railprof" id="railProf" onclick="switchProfile()"></button>
    <div class="railsync" id="railSync" style="display:none"></div>
    <div class="streak" id="streakBox"></div>
    <nav class="nav" id="nav"></nav>
  </aside>

  <div class="main">
    <header class="topbar">
      <button class="tb-btn mobile-only" onclick="toggleRail()">☰</button>
      <div class="search-wrap">
        <span class="search-ic">🔍</span>
        <input class="search" id="search" placeholder="Search questions, topics, explanations…" autocomplete="off">
        <div class="results" id="results"></div>
      </div>
      <div class="topbar-actions">
        <button class="tb-btn" onclick="showShortcuts()" title="Keyboard shortcuts">⌨️</button>
        <button class="tb-btn" onclick="exportData()">Export</button>
        <button class="tb-btn" onclick="document.getElementById('importFile').click()">Import</button>
        <input type="file" id="importFile" accept=".json" style="display:none" onchange="importData(event)">
      </div>
    </header>
    <main class="page" id="page"></main>
  </div>
</div>

<div class="splash" id="splash">
  <div class="glogo"><span class="blip">&#129658;</span> Herophilus</div>
  <div class="spinner"></div>
  <div class="msg" id="splashMsg">Restoring your session&hellip;</div>
</div>
<div class="gate" id="gate"></div>
<div class="toast" id="toast"></div>
<div class="modal-bg" id="modalBg" onclick="if(event.target===this)closeModal()">
  <div class="modal" id="modal"></div>
</div>

<script>

/* ==========================================================================
   CLOUD SYNC  \u2014  paste your Firebase config between the braces below.
   Leave it empty and the app simply runs offline with local profiles.
   Setup instructions are in the app: profile screen \u2192 "Set up sync".
