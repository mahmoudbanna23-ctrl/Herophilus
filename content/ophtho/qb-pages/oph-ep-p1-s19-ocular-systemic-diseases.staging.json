    "page_type": "question_marked",
    "printed_q": "3",
    "stem": "Ophthalmic manifestations of thyroid eye disease include EXCEPT:",
    "options": [
      "Upper lid retraction",
      "Proptosis",
      "Monocular diplopia due to extraocular muscle involvement",
      "Visual loss due to optic nerve compression"
    ],
    "key_letter": "c",
    "key_index": 2,
