.3),transparent 55%);transform:translateX(calc((.75 - var(--p))*150%));mix-blend-mode:screen}.book img{width:32%;max-height:100%;object-fit:contain}.book b,.book small{display:block}.book b{font-family:Cinzel,serif;font-size:clamp(.65rem,1.35vw,1.25rem)}.book small{color:#ead8bb;font-size:clamp(.65rem,1vw,.95rem);font-style:italic}.book i{margin-left:auto;width:clamp(28px,3vw,42px);aspect-ratio:1;border-radius:50%;background:conic-gradient(#f8d48e calc(max(0,min(1,(var(--p) - .70 - var(--delay))*3))*1turn),#ffffff22 0);mask:radial-gradient(farthest-side,transparent 70%,#000 72%)}.ent{--delay:0}.oph{--delay:.055}.neuro{--delay:.11}.peds{--delay:.165}@keyframes progress{to{--p:1}}@supports not (animation-timeline:scroll()) {.scene{animation:none}}@media (max-width:700px){.subjects{grid-template-columns:repeat(2,1fr);height:24vh;bottom:3%}.daily{inset:25% 12% 29%}.copy{top:8%;left:6%}.letters{left:-4%}.tablet{right:-8%}.pile{display:none}}@media (prefers-reduced-motion:reduce){.scene{animation:none;--p:1}.plate{transform:scale(1.25)}#dust{display:none}.shaft{transform:none}.copy span,.book{transform:none}}

