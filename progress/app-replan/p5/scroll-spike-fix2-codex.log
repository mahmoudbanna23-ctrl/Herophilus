ransform:translate(-8vw,-2vh) rotate(5deg)}}@keyframes near{20%{opacity:1}to{opacity:1;transform:translate(-12vw,2vh) rotate(3deg)}}@keyframes wipe{to{clip-path:inset(0)}}@keyframes rise{to{opacity:1;transform:translateY(0)}}@keyframes card{to{opacity:1;transform:none;filter:blur(0)}}@keyframes edge{to{transform:translateX(22%);opacity:.48}}@keyframes fill{to{transform:rotate(0deg)}}
+.plate{--range:0% 20%;--anim:plate}.candle-pool{--range:0% 24%;--anim:pool}.shaft{--range:20% 45%;--anim:shaft}.letters{--range:20% 54%;--anim:far}.tablet{--range:22% 55%;--anim:mid}.pile{--range:24% 58%;--anim:near}.daily-mask{--range:45% 70%;--anim:wipe}.line-a .line-content{--range:52% 66%;--anim:rise}.line-b .line-content{--range:59% 73%;--anim:rise}.book{--anim:card}.book:after{--range:70% 100%;--anim:edge}.ring-sweep{--anim:fill}.ent{--range:70% 85%}.oph{--range:74% 89%}.neuro{--range:78% 94%}.peds{--range:82% 97%}.book .ring-sweep{--range:inherit}
