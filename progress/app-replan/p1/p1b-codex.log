217:    if(!x){out.answers[id]=y;return}
218:    if(!y){out.answers[id]=x;return}
219:    out.answers[id]=((x.at||0)>=(y.at||0))?x:y;
220:  });
221:  ['srs','hl','flags','conf','days','sched'].forEach(k=>{
222:    out[k]=Object.assign({},older[k]||{},newer[k]||{});
223:  });
224:  /* Each chapter has its own clock: practising another chapter on a second
225:     device must not discard a more recent place in this one. */
226:  out.resumeByChapter={};
227:  const chapters=new Set(Object.keys(a.resumeByChapter||{}).concat(Object.keys(b.resumeByChapter||{})));
228:  chapters.forEach(cid=>{
229:    const x=(a.resumeByChapter||{})[cid], y=(b.resumeByChapter||{})[cid];
230:    out.resumeByChapter[cid]=!x?y:!y?x:((x.at||0)>=(y.at||0)?x:y);
231:  });
232:  /* A note and a report are written per question and stamped, so they merge the
233:     way answers do. Object.assign would let the whole of an older device's notes
234:     lose to the whole of a newer one's, which is how a note gets typed on a phone
235:     and vanishes on a laptop. */
236:  ['notes','reports'].forEach(k=>{
237:    out[k]={};
238:    const keys=new Set(Object.keys(a[k]||{}).concat(Object.keys(b[k]||{})));
239:    keys.forEach(id=>{
240:      const x=(a[k]||{})[id], y=(b[k]||{})[id];
241:      out[k][id]=!x?y:!y?x:((x.at||0)>=(y.at||0)?x:y);
242:    });
