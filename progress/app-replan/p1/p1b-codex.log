173:/* ============ HELPERS ============ */
174:const $=id=>document.getElementById(id);
175:const chapterName=id=>{for(const m of MODULES)for(const g of m.groups)for(const c of g.chapters)if(c[0]===id)return c[1];return id};
176:const moduleOf=id=>MODULES.find(m=>m.id===id);
177:/* The three question banks the material comes from. Order here is the order the
178:   filter chips render in. `bank` on a question is one of these ids; anything
179:   missing one is treated as 'endpoint', which is where every question
180:   transcribed before the field existed came from. */
181:const BANKS=[
182:  {id:'endpoint', name:'Endpoint',   hex:'#9a6b1f'},
183:  {id:'house',    name:'House',      hex:'#2f6b8f'},
184:  {id:'gradegain',name:'Grade Gain', hex:'#8f3f5c'}
185:];
186:/* Module id -> artwork basename. The ids and the filenames diverge (neuropsych
187:   vs mod-neuro), so this map exists rather than a string template. */
188:const MOD_ART={ent:'mod-ent',ophtho:'mod-ophtho',neuropsych:'mod-neuro',pediatrics:'mod-peds'};
189:
190:/* A question's clinical photograph, cropped out of the bank by
191:   Design\scripts\q-images.ps1 and named for the source page it came from â€”
192:   q.image is 'q-2844', which cites ENT endpoint.pdf p.2844 by itself.
193:
194:   âš ï¸ The path is BUILT HERE and never written as a literal src in a template.
195:   A single-file build has no assets\ folder, so the bundler has to rewrite
196:   these to data: URIs â€” the same reason poseSrc() and MOD_ART exist. One
197:   function is one place for it to intercept; a literal src is a broken image
198:   that the bundler cannot see and that throws nothing when it fails. */
199:function qImgSrc(name){ return `assets/q/${name}.jpg`; }
200:
201:/* The figure block. `imgAlt` is the bank's own wording for what the picture is
202:   ("otoscopy of the left ear"); where a question is unanswerable without the
203:   picture the caption says so, because a learner whose images failed to load
204:   otherwise just sees a question that makes no sense. */
205:function qFigure(q){
206:  if(!q.image) return '';
207:  const alt=q.imgAlt||'Clinical image printed with this question';
208:  /* imgSpoils: the printed figure answers the question, so it stays blurred until the answer is shown. */
209:  const veil=q.imgSpoils&&!(typeof Q!=='undefined'&&Q.shown);
210:  return `<figure class="qfig${veil?' veil':''}">
211:    <div class="qfig-media"><img src="${qImgSrc(q.image)}" alt="${esc(alt)}" onclick="openZoom('${q.image}')" onerror="qFigure.failed(this)">
212:      <p class="qfig-failure" role="alert" hidden>The figure could not be loaded. This question needs it. Reload the page to try again.</p></div>
213:    <figcaption>${esc(alt)}${q.imgEssential?' â€” this question cannot be answered without it.':''}
214:      <span class="qfig-hint">${veil?'Revealed after you answer.':'Tap to enlarge.'}</span></figcaption>
215:  </figure>`;
216:}
