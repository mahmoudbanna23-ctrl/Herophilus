68:   fits in the byte budget. Two survive the budget no matter what. */
69:function bakPrune(snaps){
70:  snaps.sort((a,b)=>b.at-a.at);
71:  const keep=[], days={};
72:  snaps.forEach((s,i)=>{
73:    if(i<3){keep.push(s);days[s.day]=1;return}
74:    if(!days[s.day]&&Object.keys(days).length<7){keep.push(s);days[s.day]=1}
75:  });
76:  const out=[]; let total=0;
77:  for(const s of keep){
78:    total+=s.json.length;
79:    if(total>BAK_MAX_BYTES&&out.length>=2)break;
80:    out.push(s);
81:  }
82:  return out;
83:}
84:function bakSnapshot(){
85:  if(!me)return;
86:  let json;
87:  try{ json=JSON.stringify(S) }catch(e){ return }
88:  const box=bakRead();
89:  /* nothing changed since the last one â€” do not spend a slot on a duplicate */
90:  if(box.snaps[0]&&box.snaps[0].json===json){ paintBakBtn(); return }
91:  box.snaps.unshift({at:Date.now(),day:todayISO(),json:json});
92:  box.snaps=bakPrune(box.snaps);
93:  bakWrite(box);
94:}
95:/* Debounced off save(): a burst of answers collapses into one snapshot, and
96:   after that at most one every four minutes. */
97:function bakSchedule(){
98:  if(bakTimer)return;
99:  const wait=Math.max(4000,240000-(Date.now()-bakLast));
100:  bakTimer=setTimeout(()=>{ bakTimer=null; bakLast=Date.now(); bakSnapshot() },wait);
101:}
102:function bakNewest(){
103:  /* Walks the list newest-first. The previous version took only snaps[0], so a
104:     truncated or corrupt newest snapshot was a complete outage: loadState()
105:     would conclude there was nothing to rescue while five perfectly good
106:     snapshots sat behind the bad one. Walk past every entry that fails to
107:     parse, keep returning the same {at,state} shape the caller already reads,
108:     and only return null when nothing in the list is usable. A rescue path is
109:     the wrong place to delete anything â€” bad entries are left alone in storage
110:     so bakRestore() can still see them and the snapshot history is not
111:     quietly rewritten by the one path that exists to be safe. */
112:  const box=bakRead();
113:  const snaps=box.snaps||[];
114:  for(let i=0;i<snaps.length;i++){
115:    const s=snaps[i];
116:    if(!s)continue;
117:    try{ return {at:s.at,state:JSON.parse(s.json)} }catch(e){}
118:  }
119:  return null;
120:}

