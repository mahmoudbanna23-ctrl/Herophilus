24:/* Shape: [{date, rest, items:[{label,text,hex}]}], sorted by date.
25:
26:   THERE IS NO BUILT-IN PLAN, and that is deliberate. The app used to ship one
27:   author's revision timetable, built around one faculty's exam dates. Everyone
28:   who opened it inherited a stranger's plan and had to demolish it before their
29:   own could exist â€” and the dates were wrong for them the moment the calendar
30:   moved on. A schedule is the one thing here that cannot be written for someone
31:   else, so every profile starts empty and builds its own. `data/schedule.js` was
32:   deleted with this change; nothing else read it. */
33:function activeSchedule(){
34:  if(!S.schedule)S.schedule=[];
35:  return S.schedule;
36:}
37:function saveSchedule(){save();render()}
38:
39:/* ============ STORAGE ============ */
40:let KEY='wardround.v2';
41:/* banks: per-module source filter, {ent:['endpoint','house'], â€¦}. An absent or
42:   empty entry means "all sources" â€” never store the full set, so a bank added
43:   later is included by default instead of silently hidden. */
44:let S={answers:{},flags:{},conf:{},sched:{},srs:{},days:{},hl:{},banks:{},resumeByChapter:{},notes:{},reports:{}};
45:let storageMode='memory';
46:
47:async function loadState(){
48:  const key=KEY,p=me,entry=profileLoad;
49:  let raw=null,mode='local';
50:  try{
51:    if(typeof window!=='undefined'&&window.storage&&window.storage.get){
52:      const r=await window.storage.get(key);
53:      if(entry!==profileLoad||me!==p)return;
54:      raw=r&&r.value;mode='cloud';
55:    }
56:  }catch(e){if(entry!==profileLoad||me!==p)return;mode='local'}
57:  /* Parsing and checking share their own try so a missing, unreadable or
58:     unusable value reaches the existing snapshot ladder instead of becoming
59:     live state or dropping the app to memory-only storage. */
60:  try{
61:    if(mode==='local'){try{ raw=localStorage.getItem(key) }catch(e){}}
62:    let parsed=null;
63:    if(raw){ try{ parsed=checkedProgressState(JSON.parse(raw)) }catch(e){ parsed=null } }
64:    if(!parsed){
65:      const r=bakNewest();
66:      if(r){
67:        try{ parsed=checkedProgressState(r.state); bakRestored=r.at }catch(e){}
68:      }
69:    }
70:    if(parsed)S=Object.assign(S,parsed);
71:    if(!S.hl)S.hl={};
72:    storageMode=mode;
73:    migrateSched();dropAI();
74:  }catch(e){storageMode='memory'}
75:}
76:function dropAI(){delete S.ai;delete S.aiKey;delete S.hideFileWarn}
77:function migrateSched(){
78:  const out={};
79:  Object.keys(S.sched||{}).forEach(k=>{
80:    if(/\|\d+$/.test(k)){out[k]=S.sched[k];return}
81:    if(k.indexOf('|main')>0){out[k.replace('|main','|0')]=S.sched[k];return}
82:    if(k.indexOf('|peds')>0){out[k.replace('|peds','|1')]=S.sched[k];return}
83:    out[k+'|0']=S.sched[k];out[k+'|1']=S.sched[k];
84:  });
85:  S.sched=out;
86:}
87:/* A toast disappears and the page is rebuilt on every answer. This notice lives
88:   outside the page, so a storage failure stays visible throughout this visit. */
89:function warnSaveFailure(message,id='saveWarning'){
90:  if(document.getElementById(id))return;
91:  const box=document.createElement('div');
92:  box.id=id;
93:  box.setAttribute('role','alert');
94:  box.innerHTML='<span class="warnico" aria-hidden="true">!</span>'+(message||'<p><strong>Saving failed during this visit.</strong> Recent progress may be missing from storage. Keep this tab open and download a copy before leaving.</p>'+
95:    '<button class="btn sec" onclick="exportData()">Download progress</button>');
96:  const page=document.getElementById('page');
97:  page.parentNode.insertBefore(box,page);
98:  if(!message)toast('Progress could not be saved. Please read the saving warning.');
99:}
100:/* The aggregators deliberately tolerate absent files. Checking their inputs
101:   here prevents a missing or unparseable script from looking like a small bank.
102:   Empty arrays and maps are valid, including subjects still being prepared. */
103:warnSaveFailure.checkData=function(){
104:  const missing=[];
105:  const subjects=[
106:    ['ENT','ent',['Q_ENT','C_ENT'],['T_ENT']],
107:    ['Pediatrics','pediatrics',['Q_PEDS','Q_PEDS_EP','Q_PEDS_EP2','C_PEDS'],['T_PEDS']],
108:    ['Ophthalmology','ophtho',['Q_OPHTHO','Q_OPHTHO_EP','Q_OPHTHO_EP2','C_OPHTHO'],['T_OPHTHO']],
109:    ['Neuro/Psych','neuropsych',['Q_NEURO','C_NEURO'],['T_NEURO']]
110:  ];
111:  /* The launch build leaves out the data for a locked subject on purpose, and
112:     every theory file while that section is locked. Looking for those files is
113:     looking for something the build was told not to ship, which is why the
114:     upload showed all four subjects failing while the rail counted 4,049
115:     questions. Only the files that should be present are checked. */
116:  let locked=[];
117:  try{if(typeof LOCKED_MODULES!=='undefined'&&Array.isArray(LOCKED_MODULES))locked=LOCKED_MODULES}catch(e){}
118:  let notesLocked=false;
119:  try{notesLocked=typeof THEORY_LOCKED!=='undefined'&&!!THEORY_LOCKED}catch(e){}
120:  subjects.forEach(s=>{
121:    if(locked.indexOf(s[1])>=0)return;
122:    const banksGone=s[2].some(k=>!Array.isArray(window[k]));
123:    const notesGone=!notesLocked&&s[3].some(k=>
124:      !window[k]||typeof window[k]!=='object'||Array.isArray(window[k]));
125:    if(banksGone||notesGone)missing.push(s[0]);
126:  });
127:  /* MODULES is a lexical constant, so looking on window would falsely report
128:     a failure on every healthy boot. Without the catalogue no subject can open. */
129:  let catalogue=false;
130:  try{catalogue=typeof MODULES!=='undefined'&&Array.isArray(MODULES)}catch(e){}
131:  if(!catalogue)missing.push('all subjects (module list)');
132:  if(missing.length)warnSaveFailure('<p><strong>Part of the question bank failed to load.</strong> Affected: '+
133:    missing.join(', ')+'. Reload the page.'+(catalogue?' You can study the subjects that loaded.':'')+'</p>', 'dataWarning');
134:  return catalogue;
135:};
136:async function save(){
137:  S.updatedAt=Date.now();
138:  let saved=false;
139:  try{
140:    if(storageMode==='cloud'&&window.storage&&window.storage.set){
141:      const key=KEY,raw=JSON.stringify(S),storage=window.storage;
142:      /* Each key has one active write and one replaceable pending write, so
143:         a slow earlier request cannot overwrite a later answer. Keeping the
144:         key and payload together also prevents writes crossing profiles.
145:         A superseded caller gets false because its payload was not persisted. */
146:      const writes=save.cloudWrites||(save.cloudWrites=new Map());
147:      let queue=writes.get(key);
148:      if(!queue){queue={running:false,pending:null};writes.set(key,queue)}
149:      saved=await new Promise(resolve=>{
150:        if(queue.pending)queue.pending.resolve(false);
151:        queue.pending={raw:raw,storage:storage,resolve:resolve};
152:        if(queue.running)return;
153:        queue.running=true;
154:        (async()=>{
155:          while(queue.pending){
156:            const job=queue.pending;queue.pending=null;
157:            let ok=false;
158:            try{await job.storage.set(key,job.raw);ok=true}catch(e){warnSaveFailure()}
159:            job.resolve(ok);
160:          }
161:          writes.delete(key);
162:        })();
163:      });
164:    }
165:    else if(storageMode==='local'){localStorage.setItem(KEY,JSON.stringify(S));saved=true}
166:    else throw new Error('No persistent storage is available');
167:  }catch(e){warnSaveFailure()}
168:  schedulePush();
169:  bakSchedule();
170:  return saved;
171:}
