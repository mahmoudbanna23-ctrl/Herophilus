(r.paper===null)return true;\\r\\n15:  const p=r.paper, e=obj(p)&&p.exam;\\r\\n16:  if(obj(p)&&Object.prototype.hasOwnProperty.call(p,'term')&&\\r\\n17:     !TERMS.some(t=>t.id===p.term))return false;\\r\\n18:  if(!obj(p)||!Array.isArray(p.ids)||!p.ids.length||\\r\\n19:     !p.ids.every(id=>typeof id==='string'&&id&&\\r\\n20:       ['__proto__','constructor','prototype'].indexOf(id)<0)||\\r\\n21:     new Set(p.ids).size!==p.ids.length||\\r\\n22:     !Number.isInteger(p.i)||p.i<0||p.i>=p.ids.length||\\r\\n23:     typeof p.title!=='string'||!num(p.t0)||!obj(e)||\\r\\n24:     !num(e.end)||e.end<=p.t0||!num(e.mins)||e.mins<=0||\\r\\n25:     e.done!==false||!obj(e.picked))return false;\\r\\n26:  return Object.keys(e.picked).every(id=>p.ids.indexOf(id)>=0&&\\r\\n27:    Number.isInteger(e.picked[id])&&e.picked[id]>=0);\\r\\n28:}\\r\\n29:function writeMockResume(paper){\\r\\n30:  const old=S.mockResume;\\r\\n31:  const at=old&&Number.isFinite(old.at)?old.at:0;\\r\\n32:  S.mockResume={at:Math.max(Date.now(),at+1),\\r\\n33:    paper:paper===null?null:JSON.parse(JSON.stringify(paper))};\\r\\n34:}\\r\\n35:function savedMockProblem(r){\\r\\n36:  if(!validMockResume(r))return 'The saved paper is damaged and cannot be resumed. Download a copy before discarding it.';\\r\\n37:  const p=r.paper;\\r\\n38:  const unavailable=p.ids.some(id=>{\\r\\n39:    const q=QUESTIONS.find(x=>x.id===id);\\r\\n40:    return !q||!mockable(q)||!Array.isArray(q.options)||!q.options.length||\\r\\n41:      (Object.prototype.hasOwnProperty.call(p.exam.picked,id)&&p.exam.picked[id]>=q.options.length);\\r\\n42:  });\\r\\n43:  return unavailable?'Some saved questions or options are unavailable. The whole paper is kept; it cannot be resumed or handed in with questions removed. Download a copy before discarding it.':'';\\r\\n44:}\\r\\n45:function offerMockResume(){\\r\\n46:  if(!hasSavedMock())return;\\r\\n47:  const r=S.mockResume, entry=profileLoad;\\r\\n48:  const problem=savedMockProblem(r);\\r\\n49:  const