classList.contains('show')){\\\\r\\\\n316:    if(e.key==='Escape'){closeModal();return}\\\\r\\\\n317:    return;\\\\r\\\\n318:  }\\\\r\\\\n319:  /* The search results listbox is a different case and belongs to doSearch(): a\\\\r\\\\n320:     focused result button answers its own keys (ArrowDown/Up/Enter/Escape) via\\\\r\\\\n321:     the keydown listener attached at render time. If focus is on a result while\\\\r\\\\n322:     the listbox is open, the page underneath must also stay silent â€” without\\\\r\\\\n323:     this, pressing A on a focused result would pick an answer behind it. */\\\\r\\\\n324:  if($('results').classList.contains('show')&&e.target.closest&&e.target.closest('#results'))return;\\\\r\\\\n325:  if(e.key==='Escape'){closeModal();$('results').classList.remove('show');return}\\\\r\\\\n326:  if(e.key==='/'){e.preventDefault();$('search').focus();return}\\\\r\\\\n327:  /* Global, so it works while reading theory as well as in a quiz. Safe above\\\\r\\\\n328:     the quiz guard because typing targets bailed out at the top of the handler. */\\\\r\\\\n329:  if(e.key==='t'||e.key==='T'){toggleTheme();return}\\\\r\\\\n330:  /* Page turning. Above the quiz guard so it works while reading, and it only\\\\r\\\\n331:     fires when the reader is actually up. */\\\\r\\\\n332:  if(bkOn()){\\\\r\\\\n333:    if(e.key==='ArrowRight'||e.key==='PageDown'||e.key===' '){e.preventDefault();bkTurn(1);return}\\\\r\\\\n334:    if(e.key==='ArrowLeft'||e.key==='PageUp'){e.preventDefault();bkTurn(-1);return}\\\\r\\\\n335:    if(e.key==='Home'){e.preventDefault();BK.page=0;bkPaint();return}\\\\r\\\\n336:    if(e.key==='End'){e.preventDefault();BK.page=BK.pages-1;bkPaint();return}\\\\r\\\\n337:  }\\\\r\\\\n338:  if(view.name!=='quiz')return;\\\\r\\\\n339:  const q=QUESTIONS.find(x=>x.id===Q.ids[Q.i]);\\\\r\\\\n340:  if(!q)return;\\\\r\\\\n341:  const k=e.key.toUpperCase();\\\\r\\\\n342:  if(!Q.shown&&q.options&&k.length===1){const i=OPT_LETTERS.indexOf(k);if(i>=0&&i<q.options.length){pick(i,true);return}}\\\\r\\\\n343:  if(k==='E'&&Q.shown){const b=document.querySelector('.ex-head');if(b)toggleExp(b);return}\\\\r\\\\n344:  if('1234'.includes(e.key)){setPen(PENS[+e.key-1][0]);return}\\\\r\\\\n345:  if(e.key==='0'){setPen('er');return}\\\\r\\\\n346:  if(k==='J'){openJump();return}\\\\r\\\\n347:  if(k==='F'){toggleFlag(q.id);return}\\\\r\\\\n348:  /* In a paper Enter moves on â€” there is nothing to reveal. */\\\\r\\\\n349:  if(e.key==='Enter'){e.preventDefault();(Q.shown||Q.exam)?navQ(1):(q.type==='case'?revealCase():reveal());return}\\\\r\\\\n350:  if(e.key==='ArrowRight'){navQ(1);return}\\\\r\\\\n351:  if(e.key==='ArrowLeft'){navQ(-1);return}\\\\r\\\\n352:});\\\\r\\\\n### app/js/quiz.js\\\\r\\\\n1:function hasStoredMock(){return !!(S.mockResume&&S.mockResume.paper!==null)}\\\\r\\\\n2:function hasSavedMock(){\\\\r\\\\n3:  if(!hasStoredMock())return false;\\\\r\\\\n4:  const p=S.mockResume.paper;\\\\r\\\\n5:  /* Papers saved before terms existed all belong to the original semester.\\\\r\\\\n6:     A hidden paper remains stored rather than becoming an unavailable-paper warning. */\\\\r\\\\n7:  return ((p&&p.term)||'y4s2')===activeTerm;\\\\r\\\\n8:}\\\\r\\\\n9:function validMockResume(r){\\\\r\\\\n10:  const obj=v=>v!==null&&typeof v==='object'&&!Array.isArray(v);\\\\r\\\\n11:  const num=v=>typeof v==='number'&&Number.isFinite(v)&&v>=0;\\\\r\\\\n12:  if(r===null)return true;\\\\r\\\\n13:  if(!obj(r)||!num(r.at))return false;\\\\r\\\\n14:  if(r.paper===null)return true;\\\\r\\\\n15:  const p=r.paper, e=obj(p)&&p.exam;\\\\r\\\\n16:  if(obj(p)&&Object.prototype.hasOwnProperty.call(p,'term')&&\\\\r\\\\n17:     !TERMS.some(t=>t.id===p.term))return false;\\\\r\\\\n18:  if(!obj(p)||!Array.isArray(p.ids)||!p.ids.length||\\\\r\\\\n19:     !p.ids.every(id=>typeof id==='string'&&id&&\\\\r\\\\n20:       ['__proto__','constructor','prototype'].indexOf(id)<0)||\\\\r\\\\n21:     new Set(p.ids).size!==p.ids.length||\\\\r\\\\n22:     !Number.isInteger(p.i)||p.