empty THEORY map rather than throw.\r\n 142:   if (THEORY_LOCKED && base !== 'theory.js' &&\r\n 143:       base.toLowerCase().startsWith('theory.') && base.toLowerCase().endsWith('.js')) {\r\n 144:     excludedRel.add(src);\r\n 145:   }\r\n 146: }\r\n 147: \r\n 148: // Same refusal as the locked subjects get, for the same reason: if the section\r\n 149: // is locked and nothing matched, the naming changed and this tool no longer\r\n 150: // knows what it is meant to be withholding.\r\n 151: if (THEORY_LOCKED) {\r\n 152:   const theoryHits = [...excludedRel].filter(r => path.basename(r) !== 'theory.js' &&\r\n 153:     path.basename(r).toLowerCase().startsWith('theory.'));\r\n 154:   if (!theoryHits.length) {\r\n 155:     console.error('REFUSING: THEORY_LOCKED is true, but no per-subject theory file was found ' +\r\n 156:       'among the <script src> tags in index.html. Either those files were renamed, or they are ' +\r\n 157:       'genuinely gone; either way the exclusion cannot be confirmed and will not be guessed.');\r\n 158:     process.exit(1);\r\n 159:   }\r\n 160: }\r\n 161: \r\n 162: // The constraint that matters most here: if a locked subject turns out to\r\n 163: // have NO matching file, that is not \"nothing to exclude\" â€” it means the\r\n 164: // naming scheme changed and this tool no longer knows what to drop. Refuse\r\n 165: // rather than ship the subject's data by accident.\r\n 166: for (const subj of LOCKED_SUBJECTS) {\r\n 167:   const hit = [...excludedRel].some(r => path.basename(r).toLowerCase().includes(subj));\r\n 168:   if (!hit) {\r\n 169:     console.error('REFUSING: no data file found for locked subject \"' + subj + '\" â€” ' +\r\n 170:       'checked every <script src> in index.html against the app/data/ listing and found ' +\r\n 171:       'nothing matching. Either the subject\\'s file was renamed, or it is genuinely gone; ' +\r\n 172:       'either way this tool cannot confirm the exclusion and will not guess.');\r\n 173:     process.exit(1);\r\n 174:   }\r\n 175: }\r\n 176: \r\n 177: // ----------------------------------------------------------------------\r\n 178: // 3. Confirm the graceful-degradation design before relying on it. Each\r\n 179: //    excluded file declares one `var NAME = ...`; each aggregator must read\r\n 180: //    `window.NAME || <empty>` for that same NAME, or removing the file would\r\n 181: //    throw instead of quietly shipping nothing for that subject.\r\n 182: // ----------------------------------------------------------------------\r\n 183: function declaredVarName(absPath) {\r\n 184:   const src = fs.readFileSync(absPath, 'utf8');\r\n 185:   const m = src.match(/\\bvar\\s+([A-Z][A-Za-z0-9_]*)\\s*=/);\r\n 186:   return m ? m[1] : null;\r\n 187: }\r\n 188: const AGGREGATORS = ['questions.js', 'theory.js'].map(f => path.join(APP, 'data', f));\r\n 189: const aggregatorSrc = AGGREGATORS.map(f => fs.readFileSync(f, 'utf8')).join('\\n');\r\n 190: \r\n 191: const designFailures = [];\r\n 192: for (const rel of excludedRel) {\r\n 193:   const abs = path.join(APP, rel);\r\n 194:   const varName = declaredVarName(abs);\r\n 195:   if (!varName) {\r\n 196:     designFailures.push(rel + ': found no top-level \"var NAME = ...\" to check â€” cannot confirm it degrades safely.');\r\n 197:     continue;\r\n 198:   }\r\n 199:   const fallbackRe = new RegExp('window\\\\.' + varName + '\\\\s*\\\\|\\\\|\\\\s*(?:\\\\[\\\\]|\\\\{\\\\})');\r\n 200:   if (!fallbackRe.test(aggregatorSrc)) {\r\n 201:     designFailures.push(rel + ' declares ' + varName + ', but neither questions.js nor theory.js ' +\r\n 202:       'reads \"window.' + varName + ' || []\" / \"|| {}\" â€” removing this file would leave a dangling ' +\r\n 203:       'reference instead of an empty subject.');\r\n 204:   }\r\n 205: }\r\n 206: if (designFailures.length) {\r\n 207:   console.error('REFUSING: the graceful-degradation design could not be confirmed for what would be excluded:');\r\n 208:   designFailures.forEach(f => console.error('  - ' + f));\r\n 209:   console.error('Fix the aggregator (or this check) before building â€” shipping on an unconfirmed assumption here is the one failure that matters.');\r\n 210:   process.exit(1);\r\n 211: }\r\n 212: \r\n 213: // ----------------------------------------------------------------------\r\n 214: // 4. Remove the excluded files and their <script> tags.\r\n 215: // ----------------------------------------------------------------------\r\n 216: const excludedReport = [];\r\n 217: for (const rel of excludedRel) {\r\n 218:   const distAbs = path.join(DIST, rel);\r\n 219:   let bytes = 0;\r\n 220:   try { bytes = fs.statSync(distAbs).size; } catch (e) { /* already gone is fine */ }\r\n 221:   fs.rmSync(distAbs, { force: true });\r\n 222:   const escaped = rel.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\r\n 223:   const tagRe = new RegExp('[ \\\\t]*<script\\\\b[^>]*\\\\bsrc=\"' + escaped + '\"[^>]*>\\\\s*<\\\\/script>\\\\r?\\\\n?', 'g');\r\n 224:   html = html.replace(tagRe, '');\r\n 225:   excludedReport.push({ file: rel, bytes });\r\n 226: }\r\n 227: \r\n 228: // ----------------------------------------------------------------------\r\n 229: // 5. Drop image assets that ONLY the excluded subjects reference. This is\r\n 230: //    only done where it can be checked reliably: every app/data/*.js file is\r\n 231: //    scanned for the literal `image:'name'` field (the only form the schema\r\n 232: //    uses â€” no computed image names exist in this codebase, confirmed by\r\n 233: //    grep before writing this tool), and a name is dropped only if EVERY\r\n 234: //    reference to it came from an excluded file. One reference from a kept\r\n 235: //    subject is enough to keep the image shipped.\r\n 236: // ----------------------------------------------------------------------\r\n 237: const imgRe = /image\\s*:\\s*['\"]([^'\"]+)['\"]/g;\r\n 238: const keptImageNames = new Set();\r\n 239: const excludedImageNames = new Set();\r\n 240: for (const f of dataDirFiles) {\r\n 241:   if (!f.endsWith('.js')) continue;\r\n 242:   const isExcludedFile = [...excludedRel].some(rel => path.basename(rel) === f);\r\n 243:   const src = fs.readFileSync(path.join(APP, 'data', f), 'utf8');\r\n 244:   let im;\r\n 245:   while ((im = imgRe.exec(src))) {\r\n 246:     (isExcludedFile ? excludedImageNames : keptImageNames).add(im[1]);\r\n 247:   }\r\n 248: }\r\n 249: const imagesToDrop = [...excludedImageNames].filter(n => !keptImageNames.has(n));\r\n 250: let droppedImageBytes = 0, droppedImageCount = 0;\r\n 251: for (const name of imagesToDrop) {\r\n 252:   const p = path.join(DIST, 'assets', 'q', name + '.jpg'); // matches qImgSrc() in index.html\r\n 253:   if (fs.existsSync(p)) {\r\n 254:     droppedImageBytes += fs.statSync(p).size;\r\n 255:     fs.rmSync(p);\r\n 256:     droppedImageCount++;\r\n 257:   }\r\n 258: }\r\n 259: \r\n 260: // ----------------------------------------------------------------------\r\n 261: // 6. Cache-bust every remaining local <script src> / <link href> by\r\n 262: //    appending ?v=<hash of that file's own bytes>, computed AFTER the\r\n 263: //    excluded files are gone so nothing gets hashed that isn't shipping.\r\n 264: // ----------------------------------------------------------------------\r\n 265: function bustAttr(html, tag, attr) {\r\n 266:   const re = new RegExp('(<' + tag + '\\\\b[^>]*\\\\b' + attr + '=\")([^\"?]+)(\"[^>]*>)', 'g');\r\n 267:   return html.replace(re, (whole, pre, url, post) => {\r\n 268:     if (/^(?:https?:)?\\/\\//.test(url) || url.startsWith('data:')) return whole; // no CDN links, but never touch one if it appeared\r\n 269:     const abs = path.join(DIST, url);\r\n 270:     if (!fs.existsSync(abs)) return whole; // left as-is; caught by the dangling-reference check below\r\n 271:     const hash = crypto.createHash('sha1').update(fs.readFileSync(abs)).digest('hex').slice(0, 10);\r\n 272:     return pre + url + '?v=' + hash + post;\r\n 273:   });\r\n 274: }\r\n 