progress/app-replan/p0\logs\D-count.jsonl:7:{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"\"C:\\\\Windows\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$paths = @('\"'tools/boot-check/boot-check.js','app/index.html'); foreach (\"'$p in $paths) { Write-Output \"### $p\"; $n=0; Get-Content $p | ForEach-Object { $n++; '\"'{0,4}: {1}' -f \"'$n,$_ } }; Write-Output '\"'### loader references'; rg -n --glob '\"'!app/data/**'\"' \\\"QUESTIONS|<script|question|case|endpoint|LOCKED_MODULES\\\" app/index.html app/js tools/boot-check/boot-check.js\"","aggregated_output":"### tools/boot-check/boot-check.js\r\n   1: /* Boot the app from file:// under headless Chrome and report console errors.\r\n   2:  *\r\n   3:  *   node tools/boot-check/boot-check.js\r\n   4:  *\r\n   5:  * There was no boot harness in the repo â€” every session rebuilt one in a\r\n   6:  * scratchpad and threw it away. This is that harness, kept.\r\n   7:  *\r\n   8:  * The rules below are each a wasted run otherwise (CLAUDE.md Â§7):\r\n   9:  *\r\n  10:  *  - Copy the WHOLE app/ folder. A partial copy boots and lies.\r\n  11:  *  - âš ï¸ The Chrome --user-data-dir must not sit under a path containing \"--\".\r\n  12:  *    The session scratchpad path does (D--claude-os-...), and both Chrome and\r\n  13:  *    Edge die there with \"Multiple targets are not supported\". This script\r\n  14:  *    therefore builds its own workspace under a double-dash-free temp path and\r\n  15:  *    refuses to run if that path still contains one.\r\n  16:  *  - Stub showGate at PARSE time, before the app's own script runs, or the boot\r\n  17:  *    stops at the gate and every later check reports nothing.\r\n  18:  *  - Seed a profile so the app has state to render.\r\n  19:  *  - Kill animations and force .reveal{opacity:1} â€” IntersectionObserver never\r\n  20:  *    fires under virtual time, so unrevealed content reads as missing content.\r\n  21:  *  - One Chrome at a time, fresh profile dir, and retry: roughly one run in\r\n  22:  *    three fails silently with no DOM at all.\r\n  23:  */\r\n  24: 'use strict';\r\n  25: const fs = require('fs');\r\n  26: const os = require('os');\r\n  27: const path = require('path');\r\n  28: const { execFileSync } = require('child_process');\r\n  29: \r\n  30: const ROOT = path.resolve(__dirname, '..', '..');\r\n  31: const CHROME = 'C:/Program Files/Google/Chrome/Application/chrome.exe';\r\n  32: const EDGE = 'C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe';\r\n  33: const browser = fs.existsSync(CHROME) ? CHROME : EDGE;\r\n  34: const SELFTEST = process.argv.includes('--selftest');\r\n  35: \r\n  36: /* --dir=<path> boots something other than app\\. The reason it exists: the\r\n  37:    folder that actually ships is dist\\, built by tools\\build-launch.js with the\r\n  38:    locked subjects' data files removed, and until now nothing had ever booted\r\n  39:    the thing being uploaded â€” only the source it was built from. A build that\r\n  40:    orphans a global the aggregators do not guard would look identical here. */\r\n  41: const SRC = (() => {\r\n  42:   const a = process.argv.find(x => x.startsWith('--dir='));\r\n  43:   return a ? path.resolve(ROOT, a.slice(6)) : path.join(ROOT, 'app');\r\n  44: })();\r\n  45: \r\n  46: // A double dash anywhere in the workspace path kills both browsers.\r\n  47: const WORK = path.join(os.tmpdir(), 'herophilus_boot');\r\n  48: if (WORK.includes('--')) {\r\n  49:   console.error('REFUSING: workspace path contains \"--\" â€” Chrome dies with \"Multiple targets are not supported\".');\r\n  50:   process.exit(1);\r\n  51: }\r\n  52: \r\n  53: function rmrf(p) { if (fs.existsSync(p)) fs.rmSync(p, { recursive: true, force: true }); }\r\n  54: function copyDir(src, dst) {\r\n  55:   fs.mkdirSync(dst, { recursive: true });\r\n  56:   for (const e of fs.readdirSync(src, { withFileTypes: true })) {\r\n  57:     const s = path.join(src, e.name), d = path.join(dst, e.name);\r\n  58:     if (e.isDirectory()) copyDir(s, d); else fs.copyFileSync(s, d);\r\n  59:   }\r\n  60: }\r\n  61: \r\n  62: rmrf(WORK);\r\n  63: const APP = path.join(WORK, 'app');\r\n  64: copyDir(SRC, APP);\r\n  65: if (SRC !== path.join(ROOT, 'app')) console.log('source    ' + path.relative(ROOT, SRC));\r\n  66: \r\n  67: // The probe goes in FIRST, before the app's own <head> scripts, so it catches a\r\n  68: // parse-time throw in a data file as well as a runtime one.\r\n  69: const INDEX = path.join(APP, 'index.html');\r\n  70: let html = fs.readFileSync(INDEX, 'utf8');\r\n  71: \r\n  72: const probe = [\r\n  73:   '<script>',\r\n  74:   'window.__errs=[];',\r\n  75:   'window.addEventListener(\"error\",function(e){window.__errs.push(\"ERROR: \"+(e.message||\"\")+\" @ \"+(e.filename||\"\")+\":\"+(e.lineno||0));},true);',\r\n  76:   'window.addEventListener(\"unhandledrejection\",function(e){window.__errs.push(\"REJECT: \"+e.reason);});',\r\n  77:   '(function(){var ce=console.error;console.error=function(){window.__errs.push(\"console.error: \"+Array.prototype.join.call(arguments,\" \"));return ce.apply(console,arguments);};})();',\r\n  78:   // Stub the gate before the app defines it, and re-stub after, since the app\r\n  79:   // assigns its own. A defineProperty setter keeps ours on top either way.\r\n  80:   'Object.defineProperty(window,\"showGate\",{configurable:true,get:function(){return function(){};},set:function(){}});',\r\n  81:   // Seed a local profile before the app reads localStorage. Nothing renders on\r\n  82:   // the home view until a profile is entered, so without this the DOM is empty\r\n  83:   // and every element count reads zero â€” which looks exactly like a broken app.\r\n  84:   'try{localStorage.setItem(\"wardround.profiles\",JSON.stringify([{id:\"boot\",name:\"Boot\",\"av\":0,\"col\":0}]));}catch(e){}',\r\n  85:   '</script>',\r\n  86:   '<style>*,*::before,*::after{animation:none!important;transition:none!important}.reveal{opacity:1!important;transform:none!important}</style>',\r\n  87: ].join('\\n');\r\n  88: \r\n  89: const headAt = html.indexOf('<head>');\r\n  90: if (headAt < 0) { console.error('no <head> in index.html'); process.exit(1); }\r\n  91: html = html.slice(0, headAt + 6) + '\\n' + probe + '\\n' + html.slice(headAt + 6);\r\n  92: \r\n  93: // The report runs after load, reads what the app actually rendered, and parks\r\n  94: // the result where --dump-dom will show it.\r\n  95: const report = [\r\n  96:   '<script>',\r\n  97:   'window.addEventListener(\"load\",function(){setTimeout(function(){',\r\n  98:   // enterProfile() is what paints the home view; it is async, so measure after.\r\n  99:   '  var p=Promise.resolve();',\r\n 100:   '  try{p=enterProfile({id:\"boot\",name:\"Boot\",av:0,col:0});}catch(e){window.__errs.push(\"enterProfile THREW: \"+e.message);}',\r\n 101:   // Content is now scoped to a chosen term and QUESTIONS/THEORY start empty. A\r\n 102:   // seeded profile alone measures an empty app â€” render() returns early while\r\n 103:   // termEntryPending is true â€” which reads as catastrophic loss of all questions\r\n 104:   // and theory chapters. Mirror chooseTerm()'s tail for the term whose content\r\n 105:   // is published (id \"y4s2\") so the harness measures what the user actually sees\r\n 106:   // after picking a semester. Guard every new symbol with typeof so the harness\r\n 107:   // still runs against a pre-term build and reports honestly rather than\r\n 108:   // throwing on the first reference.\r\n 109:   '  Promise.resolve(p).catch(function(e){window.__errs.push(\"enterProfile REJECTED: \"+e);}).then(function(){',\r\n 110:   '    try{',\r\n 111:   '      if(typeof TERMS===\"undefined\"){window.__errs.push(\"term seed: TERMS undefined\");setTimeout(measure,600);return;}',\r\n 112:   '      if(typeof S===\"undefined\"){window.__errs.push(\"term seed: S undefined\");setTimeout(measure,600);return;}',\r\n 113:   '      if(typeof save!==\"function\"){window.__errs.push(\"term seed: save not a function\");setTimeout(measure,600);return;}',\r\n 114:   '      var T=null;',\r\n 115:   '      for(var i=0;i<TERMS.length;i++){if(TERMS[i]&&TERMS[i].id===\"y4s2\"){T=TERMS[i];break;}}',\r\n 116:   '      if(!T){window.__errs.push(\"term seed: y4s2 not in TERMS\");setTimeout(measure,600);return;}',\r\n 117:   '      var prev=null;',\r\n 118:   '      try{if(S&&S.term)prev=S.term;}catch(_){}',\r\n 119:   '      S.term={id:T.id,at:Math.max(Date.now(),prev?prev.at+1:0)};',\r\n 120:   '      save();',\r\n 121:   '      if(typeof termEntryPending!==\"undefined\"&&termEntryPending&&typeof finishProfileEntry===\"function\"){finishProfileEntry();}',\r\n 122:   '      else{if(typeof activateTerm===\"function\")activateTerm(T.id);if(typeof render===\"function\")render();}',\r\n 123:   '    }catch(e){window.__errs.push(\"term seed THREW: \"+e.message);}',\r\n 124:   '    setTimeout(measure,600);',\r\n 125:   '  });',\r\n 126:   '},1200);});',\r\n 127:   'function measure(){',\r\n 128:   // r.errs is filled at the END of this function, never here. The module walk\r\n 129:   // below pushes into window.__errs, so a snapshot taken now reports zero errors\r\n 130:   // for a walk that threw â€” which is exactly how this harness once passed a\r\n 131:   // broken app. Capture last, after everything that can fail has run.\r\n 132:   '  var r={};',\r\n 133:   '  try{r.questions=(typeof QUESTIONS!==\"undefined\")?QUESTIONS.length:-1;}catch(e){r.questions=\"THREW \"+e.message;}',\r\n 134:   // THEORY is an OBJECT keyed by chapter id, not an array â€” .length is undefined.\r\n 135:   '  try{r.theory=(typeof THEORY!==\"undefined\")?Object.keys(THEORY).length:-1;}catch(e){r.theory=\"THREW \"+e.message;}',\r\n 136:   '  try{r.modules=(typeof MODULES!==\"undefined\")?MODULES.length:-1;}catch(e){r.modules=\"THREW \"+e.message;}',\r\n 137:   // Chapters are nested TWO deep: module -> groups[] -> chapters[].\r\n 138:   '  try{r.chapters=(typeof MODULES!==\"undefined\")?MODULES.reduce(function(a,m){return a+m.groups.reduce(function(k,g){return k+g.chapters.length;},0);},0):-1;}catch(e){r.chapters=\"THREW \"+e.message;}',\r\n 139:   '  try{r.ophtho=(typeof Q_OPHTHO!==\"undefined\")?Q_OPHTHO.length:-1;}catch(e){r.ophtho=\"THREW \"+e.message;}',\r\n 140:   '  r.modCards=document.querySelectorAll(\".mod-name\").length;',\r\n 141:   // Chapter rows only exist inside a module view, so open each module in turn.\r\n 142:   // A disabled row is an EMPTY chapter, which is deliberate â€” count both.\r\n 143:   // --selftest makes the module walk throw on purpose. A harness that has never\r\n 144:   // been seen failing is not evidence that it can fail: this is how we check.\r\n 145:   SELFTEST ? '  (function(){var g=go;go=function(v){if(v&&v.name===\"module\")throw new Error(\"selftest injected fault\");return g(v);};})();' : '',\r\n 146:   '  r.chapRows=0; r.chapLive=0; r.perMod={};',\r\n 147:   '  try{MODULES.forEach(function(m){go({name:\"module\",id:m.id});',\r\n 148:   '    var rows=document.querySelectorAll(\".ch-row\");',\r\n 149:   '    r.perMod[m.id]=rows.length; r.chapRows+=rows.length;',\r\n 150:   '    r.chapLive+=document.querySelectorAll(\".ch-row:not([disabled])\").length;});',\r\n 151:   '    go({name:\"home\"});}catch(e){window.__errs.push(\"module walk THREW: \"+e.message);}',\r\n 152:   '  r.errs=window.__errs.slice(0,40);',\r\n 153:   '  document.title=\"BOOTREPORT \"+JSON.stringify(r);',\r\n 154:   '}',\r\n 155:   '</script>',\r\n 156: ].join('\\n');\r\n 157: html = html.replace('</body>', report + '\\n</body>');\r\n 158: fs.writeFileSync(INDEX, html, 'utf8');\r\n 159: \r\n 160: // Seed a profile into a first-run localStorage. file:// origins do not share\r\n 161: // storage, so the app starts empty; the gate stub is what carries the boot.\r\n 162: \r\n 163: const url = 'file:///' + INDEX.replace(/\\\\/g, '/');\r\n 164: let dom = '', lastErr = '';\r\n 165: for (let attempt = 1; attempt <= 3; attempt++) {\r\n 166:   const udd = path.join(WORK, 'chrome_profile_' + attempt);\r\n 167:   try {\r\n 168:     dom = execFileSync(browser, [\r\n 169:       '--headless=new', '--disable-gpu', '--no-sandbox', '--no-first-run',\r\n 170:       '--disable-extensions', '--allow-file-access-from-files',\r\n 171:       '--virtual-time-budget=20000', '--user-data-dir=' + udd,\r\n 172:       '--dump-dom', url,\r\n 173:     ], { encoding: 'utf8', maxBuffer: 256 * 1024 * 1024, timeout: 180000 });\r\n 174:   } catch (e) { lastErr = e.message; dom = (e.stdout || ''); }\r\n 175:   if (dom && dom.includes('BOOTREPORT')) break;\r\n 176:   console.error('attempt ' + attempt + ': no report in DOM (' + dom.length + ' bytes) â€” retrying');\r\n 177: }\r\n 178: \r\n 179: const m = dom.match(/BOOTREPORT (\\{.*?\\})<\\/title>/s);\r\n 180: if (!m) {\r\n 181:   console.error('NO BOOT REPORT after 3 attempts. dom ' + dom.length + ' bytes. last error: ' + lastErr);\r\n 182:   fs.writeFileSync(path.join(WORK, 'dump.html'), dom, 'utf8');\r\n 183:   console.error('dom written to ' + path.join(WORK, 'dump.html'));\r\n 184:   process.exit(1);\r\n 185: }\r\n 186: const r = JSON.parse(m[1].replace(/&quot;/g, '\"').replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>'));\r\n 187: console.log('browser   ' + path.basename(browser));\r\n 188: console.log('QUESTIONS ' + r.questions + '   THEORY ' + r.theory + '   MODULES ' + r.modules +\r\n 189:   '   chapters ' + r.chapters);\r\n 190: console.log('Q_OPHTHO  ' + r.ophtho + '   module cards in DOM ' + r.modCards);\r\n 191: console.log('chapter rows rendered ' + r.chapRows + ' (' + r.chapLive + ' with questions, ' +\r\n 192:   (r.chapRows - r.chapLive) + ' empty â€” empty is deliberate)');\r\n 193: console.log('  per module: ' + Object.keys(r.perMod || {}).map(k => k + ' ' + r.perMod[k]).join(' Â· '));\r\n 194: console.log('console errors: ' + r.errs.length);\r\n 195: r.errs.forEach(e => console.log('  ! ' + e));\r\n 196: process.exit(r.errs.length ? 1 : 0);\r\n### app/index.html\r\n   1: <!DOCTYPE html>\r\n   2: <html lang=\"en\">\r\n   3: <head>\r\n   4: <meta charset=\"UTF-8\">\r\n   5: <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n   6: <link rel=\"apple-touch-icon\" href=\"assets/icon-180.png\">\r\n   7: <link rel=\"icon\" type=\"image/png\" href=\"data:image/png;base64,\">\r\n   8: <meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\r\n   9: <meta name=\"apple-mobile-web-app-title\" content=\"Herophilus\">\r\n  10: <meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black-translucent\">\r\n  11: <meta name=\"mobile-web-app-capable\" content=\"yes\">\r\n  12: <meta name=\"theme-color\" content=\"#070d16\">\r\n  13: <meta name=\"description\" content=\"Herophilus â€” clinical question bank and revision schedule\">\r\n  14: <title>Herophilus â€” 2nd Term Question Bank</title>\r\n  15: <!-- Theme is chosen BEFORE any CSS parses, so a light-mode user never sees a\r\n  16:      dark flash on load. It has to be inline and it has to be here: a deferred\r\n  17:      script, or one at the end of <body>, runs after first paint and the flash\r\n  18:      is then unavoidable. Kept deliberately tiny for the same reason.\r\n  19:      No stored choice = follow the operating system. -->\r\n  20: <script>\r\n  21: (function(){\r\n  22:   var t=null;\r\n  23:   try{t=localStorage.getItem('wardround.theme')}catch(e){}\r\n  24:   if(t!=='light'&&t!=='dark'){\r\n  25:     t=(window.matchMedia&&matchMedia('(prefers-color-scheme:light)').matches)?'light':'dark';\r\n  26:   }\r\n  27:   document.documentElement.setAttribute('data-theme',t);\r\n  28: })();\r\n  29: </script>\r\n  30: <!-- Classical faces, embedded as data URIs. Must sit HERE, in <head> and before\r\n  31:      the stylesheet: a classic script blocks parsing and runs immediately, so the\r\n  32:      @font-face rules are registered before first paint. Moved to the end of\r\n  33:      <body> with the other data files, the whole page would render in a fallback\r\n  34:      face and then reflow. See data/fonts.js for why they are base64 and not\r\n  35:      .woff2 files sitting next door. -->\r\n  36: <script src=\"data/fonts.js\"></script>\r\n  37: <link rel=\"stylesheet\" href=\"css/tokens.css\">\r\n  38: <link rel=\"stylesheet\" href=\"css/base.css\">\r\n  39: <link rel=\"stylesheet\" href=\"css/layout.css\">\r\n  40: <link rel=\"stylesheet\" href=\"css/components.css\">\r\n  41: <link rel=\"stylesheet\" href=\"css/print.css\">\r\n  42: <link rel=\"stylesheet\" href=\"css/views.css\">\r\n  43: </head>\r\n  44: <body>\r\n  45: <!-- Ambient colour field. Fixed and non-interactive, sits behind .app.\r\n  46:      Its motion is paused by CSS on the reading views â€” see the cinematic layer.\r\n  47:      Source order IS the stacking order here (all children are absolute, none\r\n  48:      carries a z-index): film at the back, orbs tinting it, scrim over both. -->\r\n  49: <div class=\"ambient\" aria-hidden=\"true\">\r\n  50:   <!-- muted + playsinline are what make autoplay legal at all; without both,\r\n  51:        iOS Safari refuses and we fall back to the poster frame, which is a\r\n  52:        perfectly good still. A failure here costs atmosphere, never function. -->\r\n  53:   <video class=\"film\" autoplay muted loop playsinline preload=\"auto\"\r\n  54:          poster=\"assets/ambient-library.jpg\" tabindex=\"-1\">\r\n  55:     <source src=\"assets/ambient-library.mp4\" type=\"video/mp4\">\r\n  56:   </video>\r\n  57:   <span class=\"orb o1\"></span><span class=\"orb o2\"></span>\r\n  58:   <span class=\"orb o3\"></span><span class=\"orb o4\"></span>\r\n  59:   <span class=\"film-scrim\"></span>\r\n  60: </div>\r\n  61: <div class=\"app\">\r\n  62:   <aside class=\"rail\" id=\"rail\">\r\n  63:     <div class=\"rail-head\">\r\n  64:       <div class=\"logo\"><span class=\"blip\"><img src=\"assets/icon-96.png\" alt=\"\" width=\"