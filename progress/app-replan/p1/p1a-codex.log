+  for(const k of vars){const v=s[k]; if(Array.isArray(v)&&!collections.some(c=>c.v===v)) collections.push({file:f,name:k,v,type:k.startsWith('C_')?'case':'question'}); if(k.startsWith('T_')&&v&&typeof v==='object'&&!Array.isArray(v)&&!collections.some(c=>c.v===v))collections.push({file:f,name:k,v,type:'theory'});}
