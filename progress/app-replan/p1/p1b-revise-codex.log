 256:   const ref=docRef();
 257:   if(!ref)return;
 258:   if(!currentCloud(cloudSession))cloudSession={uid:fbUser.uid,pid:me.id,auth:cloudAuth,
 259:     ref:ref,key:KEY,mode:storageMode,running:false,again:false};
 260:   await pushCloud(cloudSession);
