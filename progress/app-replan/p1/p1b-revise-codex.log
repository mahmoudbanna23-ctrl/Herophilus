  92:     const m=String(e&&e.code||e);
  93:     if(/popup-closed|cancelled/i.test(m)){toast('Sign-in cancelled');return}
  94:     if(/unauthorized-domain/i.test(m)){toast('This address is not authorised in Firebase');return}
  95:     if(/popup-blocked/i.test(m)){
  96:       try{await firebase.auth().signInWithRedirect(prov)}catch(e2){toast('Sign-in blocked by the browser')}
