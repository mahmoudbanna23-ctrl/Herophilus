 197: /* Known fields are checked where their readers need a particular shape. Extra
 198:    JSON fields are retained, so adding a runtime field does not make exports lossy. */
 199: function checkedProgressState(st){
 200:   const own=(o,k)=>Object.prototype.hasOwnProperty.call(o,k);
 201:   const obj=v=>v!==null&&typeof v==='object'&&!Array.isArray(v);
 202:   const num=v=>typeof v==='number'&&Number.isFinite(v)&&v>=0;
 203:   const int=v=>Number.isInteger(v)&&v>=0;
 204:   const str=v=>typeof v==='string';
 205:   const bool=v=>typeof v==='boolean';
 206:   const strings=v=>Array.isArray(v)&&v.every(str);
 207:   const date=v=>str(v)&&/^\d{4}-\d{2}-\d{2}$/.test(v)&&Number.isFinite(Date.parse(v));
 208:   const optional=(o,k,test)=>!own(o,k)||test(o[k]);
 209:   const map=(v,test)=>obj(v)&&Object.keys(v).every(k=>test(v[k]));
 210:   const bad=k=>{throw new Error('Invalid progress field: '+k)};
 211:   /* JSON.parse accepts these names as data, but Object.assign and later map
 212:      writes can give them prototype behaviour. Reject them before any merge. */
 213:   function safe(v){
 214:     if(v===null||str(v)||bool(v))return true;
 215:     if(typeof v==='number')return Number.isFinite(v);
 216:     if(Array.isArray(v))return v.every(safe);
 217:     return obj(v)&&Object.keys(v).every(k=>
 218:       ['__proto__','constructor','prototype'].indexOf(k)<0&&safe(v[k]));
 219:   }
 220:   if(!obj(st)||!own(st,'answers')||!safe(st))bad('state');
 221:   const rating=v=>int(v)&&v<=2;
 222:   const answer=v=>obj(v)&&bool(v.ok)&&optional(v,'at',num)&&
 223:     (own(v,'pick')||own(v,'text'))&&
 224:     optional(v,'pick',x=>x===null||int(x))&&optional(v,'text',str)&&
 225:     optional(v,'got',int)&&optional(v,'total',int)&&optional(v,'conf',rating);
 226:   const checks={
 227:     answers:v=>map(v,answer),
 228:     flags:v=>map(v,bool),
 229:     conf:v=>map(v,rating),
 230:     sched:v=>map(v,x=>x==='done'||x==='missed'),
 231:     srs:v=>map(v,x=>obj(x)&&int(x.lvl)&&x.lvl<SRS.length&&date(x.due)),
 232:     days:v=>map(v,bool),
 233:     hl:v=>map(v,x=>Array.isArray(x)&&x.every(h=>obj(h)&&int(h.s)&&int(h.e)&&
 234:       h.e>h.s&&['y','g','p','b'].indexOf(h.c)>=0)),
 235:     banks:v=>map(v,strings),
 236:     resumeByChapter:v=>map(v,x=>obj(x)&&str(x.qid)&&strings(x.sources)&&
 237:       num(x.at)&&bool(x.finished)),
 238:     notes:v=>map(v,x=>obj(x)&&str(x.txt)&&num(x.at)),
 239:     reports:v=>map(v,x=>obj(x)&&str(x.kind)&&str(x.txt)&&num(x.at))
 240:   };
