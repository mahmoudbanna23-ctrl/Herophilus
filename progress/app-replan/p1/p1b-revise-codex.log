 186: async function syncRoster(p,remove=false){
 187:   const ref=rosterRef(),auth=cloudAuth;
 188:   if(!ref)return;
 189:   const entry=rosterProfile(p);
 190:   let live=true;
 191:   try{
 192:     await cloudWait(firebase.firestore().runTransaction(async tx=>{
 193:       const snap=await tx.get(ref);
 194:       if(!live||auth!==cloudAuth||!fbUser)return;
 195:       /* Keep a legacy state until profile entry can adopt it atomically. */
 196:       tx.set(ref,{profiles:rosterList(snap.exists?snap.data():{},entry,remove)},{merge:true});
 197:       if(remove)tx.delete(ref.collection('profiles').doc(entry.id));
 198:     }));
 199:   }catch(e){if(auth===cloudAuth)setSync('err')}
 200:   finally{live=false}
