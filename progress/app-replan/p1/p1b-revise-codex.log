 143: function cloudWait(work){
 144:   let timer;
 145:   return Promise.race([work,new Promise((_,reject)=>{
 146:     timer=setTimeout(()=>reject(new Error('Sync timed out')),8000);
 147:   })]).finally(()=>clearTimeout(timer));
 148: }
 149: function resetCloud(){
