 151: }
 152: function stopRetry(){clearInterval(retryTimer);retryTimer=null}
 153: /* A push that failed offline must not go silent until reload â€” retry once
 154:    the browser says we're back online, and slowly meanwhile in case that event
 155:    never fires. Only runs while a session exists and the last sync actually failed. */
 156: function retrySync(){
 157:   if(syncState!=='err')return;
 158:   if(!cloudEnabled()||!fbUser){stopRetry();return}
 159:   if(currentCloud(cloudSession))pushCloud(cloudSession);
 160:   else if(me)pullCloud();
