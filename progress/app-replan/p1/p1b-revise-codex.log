 202: function mergeStates(a,b){
 203:   const at=a.updatedAt||0, bt=b.updatedAt||0;
 204:   const newer=at>=bt?a:b, older=at>=bt?b:a;
 205:   const out=JSON.parse(JSON.stringify(newer));
 206:   /* Answering on another device advances updatedAt without changing the
 207:      student's semester. Only an explicit selection advances this clock.
 208:      Equal clocks use the same tie-break in either merge direction. */
 209:   const termA=termChoice(a.term), termB=termChoice(b.term);
 210:   const chosenTerm=!termA?termB:!termB?termA:
 211:     (termA.at>termB.at||(termA.at===termB.at&&termA.id>=termB.id)?termA:termB);
 212:   if(chosenTerm)out.term=chosenTerm; else delete out.term;
 213:   out.answers={};
 214:   const ids=new Set(Object.keys(a.answers||{}).concat(Object.keys(b.answers||{})));
 215:   ids.forEach(id=>{
 216:     const x=(a.answers||{})[id], y=(b.answers||{})[id];
 217:     if(!x){out.answers[id]=y;return}
 218:     if(!y){out.answers[id]=x;return}
 219:     out.answers[id]=((x.at||0)>=(y.at||0))?x:y;
 220:   });
 221:   ['srs','hl','flags','conf','days','sched'].forEach(k=>{
 222:     out[k]=Object.assign({},older[k]||{},newer[k]||{});
 223:   });
 224:   /* Each chapter has its own clock: practising another chapter on a second
 225:      device must not discard a more recent place in this one. */
 226:   out.resumeByChapter={};
 227:   const chapters=new Set(Object.keys(a.resumeByChapter||{}).concat(Object.keys(b.resumeByChapter||{})));
 228:   chapters.forEach(cid=>{
 229:     const x=(a.resumeByChapter||{})[cid], y=(b.resumeByChapter||{})[cid];
 230:     out.resumeByChapter[cid]=!x?y:!y?x:((x.at||0)>=(y.at||0)?x:y);
 231:   });
 232:   /* A note and a report are written per question and stamped, so they merge the
 233:      way answers do. Object.assign would let the whole of an older device's notes
 234:      lose to the whole of a newer one's, which is how a note gets typed on a phone
 235:      and vanishes on a laptop. */
 236:   ['notes','reports'].forEach(k=>{
 237:     out[k]={};
 238:     const keys=new Set(Object.keys(a[k]||{}).concat(Object.keys(b[k]||{})));
 239:     keys.forEach(id=>{
 240:       const x=(a[k]||{})[id], y=(b[k]||{})[id];
 241:       out[k][id]=!x?y:!y?x:((x.at||0)>=(y.at||0)?x:y);
 242:     });
 243:   });
 244:   out.schedule=newer.schedule||older.schedule||null;
 245:   /* A paper travels as one record. Combining picks from different sittings would
 246:      invent a paper; a dated empty record also prevents an older copy returning. */
 247:   const x=a.mockResume, y=b.mockResume;
 248:   out.mockResume=!x?(y||null):!y?x:
 249:     x.at!==y.at?(x.at>y.at?x:y):
 250:     x.paper===null?x:y.paper===null?y:
 251:     (JSON.stringify(x)>=JSON.stringify(y)?x:y);
 252:   out.updatedAt=Math.max(at,bt);
 253:   return out;
 254: }
