 262: function schedulePush(){
 263:   const c=cloudSession;
 264:   if(!currentCloud(c))return;
 265:   clearTimeout(pushTimer);
 266:   pushTimer=setTimeout(()=>{if(currentCloud(c))pushCloud(c)},1200);
 267: }
 268: async function pushCloud(c=cloudSession){
 269:   if(!currentCloud(c))return;
 270:   if(c.running){c.again=true;return}
 271:   c.running=true;c.again=false;
 272:   let live=true;
 273:   setSync('busy');
 274:   try{
 275:     const local=JSON.parse(JSON.stringify(S)),entry=rosterProfile(me),root=rosterRef(c.uid);
 276:     /* mergeStates rebuilds answers and resumeByChapter key by key, so its output
 277:        does not compare byte-for-byte against its input even when nothing moved.
 278:        Merging local with itself gives the same normal form, which is what makes
 279:        the comparison below mean "another device changed something" rather than
 280:        "the keys came back in a different order". */
 281:     const before=JSON.stringify(mergeStates(local,local));
 282:     const merged=await cloudWait(firebase.firestore().runTransaction(async tx=>{
 283:       const roster=await tx.get(root),snap=await tx.get(c.ref);
 284:       if(!live||!currentCloud(c))return null;
 285:       const data=roster.exists?roster.data():{};
 286:       let out=local;
 287:       if(snap.exists&&snap.data().state)out=mergeStates(out,JSON.parse(snap.data().state));
 288:       /* Removing the old field and adopting its contents in the same commit
 289:          makes retries and simultaneous first sign-ins adopt it only once. */
 290:       if(Object.prototype.hasOwnProperty.call(data,'state'))out=mergeStates(out,JSON.parse(data.state));
 291:       tx.set(c.ref,{state:JSON.stringify(out),updatedAt:Date.now()});
 292:       const list=rosterList(data);
 293:       if(!list.some(p=>p.id===entry.id))list.push(entry);
 294:       tx.set(root,{profiles:list});
 295:       return out;
 296:     }));
 297:     if(!merged||!currentCloud(c))return;
 298:     /* Include edits made during the request without scheduling an endless
 299:        save/push loop. Their existing debounce sends them on the next pass. */
 300:     S=mergeStates(S,merged);
 301:     if(!S.hl)S.hl={};
 302:     /* Apply a remote semester before another input can use the old quiz.
 303:        Profile entry draws its own screen after loading has finished. */
 304:     const termChanged=!termEntryPending&&termChoice(S.term)&&S.term.id!==activeTerm;
 305:     if(termChanged)render();
 306:     const raw=JSON.stringify(S);
 307:     try{
 308:       if(c.mode==='cloud'&&window.storage&&window.storage.set)await cloudWait(window.storage.set(c.key,raw));
 309:       else if(c.mode==='local')localStorage.setItem(c.key,raw);
 310:     }catch(e){warnSaveFailure()}

